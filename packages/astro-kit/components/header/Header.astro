---
// Site header: brand (logo and/or name), navigation and an optional call to
// action.
import { tv } from 'tailwind-variants'
import Button from '../_shared/Button.astro'
import KitImage from '../_shared/KitImage.astro'
import type { ActionInput, ImageInput, NavItem } from '../_shared/types'
import Nav from '../nav/Nav.astro'

const header = tv({
  slots: {
    root: 'z-40 w-full',
    inner: 'container-page flex items-center gap-6 py-4',
    brand: 'flex shrink-0 items-center gap-3 text-lg font-semibold tracking-tight text-current no-underline',
  },
  variants: {
    layout: {
      split: { inner: 'justify-between' },
      centered: { inner: 'flex-col gap-3 md:gap-4' },
      'brand-left': { inner: 'justify-start [&>nav]:ms-10' },
    },
    tone: {
      default: { root: 'bg-surface text-ink' },
      inverse: { root: 'bg-ink text-surface' },
      transparent: { root: 'absolute inset-x-0 top-0 bg-transparent text-surface' },
    },
    position: { static: {}, sticky: { root: 'sticky top-0' } },
    bordered: { true: {}, false: {} },
  },
  compoundVariants: [{ tone: 'default', bordered: true, class: { root: 'border-b border-line' } }],
  defaultVariants: { layout: 'split', tone: 'default', position: 'static', bordered: true },
})

interface Props {
  siteName: string
  /** A line under the site name, as themes that print the site's tagline in the header do. */
  tagline?: string | undefined
  /** The site name's size, where the source theme sets its own (a CSS length). */
  brandSize?: string | undefined
  /** The line under the bar on the default tone; `false` where the source's header draws none. */
  bordered?: boolean | undefined
  /** The site name's weight and letter-spacing, where the source theme sets its own (CSS values). */
  brandWeight?: string | undefined
  brandTracking?: string | undefined
  /** Space above the bar, and inside it above and below the content, where the source's header has its own (CSS lengths). */
  offsetTop?: string | undefined
  padTop?: string | undefined
  padBottom?: string | undefined
  /** The navigation in the site's link colour, as themes that colour every link do (Hello Elementor). */
  linkNav?: boolean | undefined
  logo?: ImageInput | undefined
  /** Show the site name next to the logo. */
  showName?: boolean | undefined
  homeHref?: string | undefined
  items: NavItem[]
  action?: ActionInput | undefined
  navLabel?: string | undefined
  menuLabel?: string | undefined
  closeLabel?: string | undefined
  layout?: 'split' | 'centered' | 'brand-left' | undefined
  tone?: 'default' | 'inverse' | 'transparent' | undefined
  position?: 'static' | 'sticky' | undefined
  /** How submenus open on wide screens: a list under the item, or a wide panel of columns. */
  menu?: 'flyout' | 'mega' | undefined
}

const { siteName, tagline, brandSize, brandWeight, brandTracking, bordered, offsetTop, padTop, padBottom, linkNav, logo, showName = true, homeHref = '/', items, action, navLabel, menuLabel, closeLabel, layout, tone, position, menu } = Astro.props
const { root, inner, brand } = header({ layout, tone, position, bordered })
const rootStyle = offsetTop ? `margin-top: ${offsetTop}` : undefined
const innerStyle = [padTop && `padding-top: ${padTop}`, padBottom && `padding-bottom: ${padBottom}`].filter(Boolean).join('; ') || undefined
const brandStyle = [brandSize && `font-size: ${brandSize}`, brandWeight && `font-weight: ${brandWeight}`, brandTracking && `letter-spacing: ${brandTracking}`].filter(Boolean).join('; ') || undefined
// A tagline under the name keeps its line on a phone, as themes print it: the navigation wraps below.
const wrap = tagline ? 'flex-wrap md:flex-nowrap' : undefined
---
<header class={root()} style={rootStyle}>
  <div class={inner({ class: wrap })} style={innerStyle}>
    {tagline
      ? (
        <div class="flex min-w-0 basis-full flex-col gap-1 md:basis-auto">
          <a href={homeHref} class={brand()} aria-label={showName ? undefined : siteName} style={brandStyle} data-kit-brand>
            {logo && <KitImage image={logo} priority class="h-8 w-auto" sizes="160px" />}
            {showName && <span>{siteName}</span>}
          </a>
          <p class="opacity-75" data-kit-tagline>{tagline}</p>
        </div>
      )
      : (
        <a href={homeHref} class={brand()} aria-label={showName ? undefined : siteName} style={brandStyle} data-kit-brand>
          {logo && <KitImage image={logo} priority class="h-8 w-auto" sizes="160px" />}
          {showName && <span>{siteName}</span>}
        </a>
      )}
    <div class:list={['flex items-center gap-4', layout === 'centered' ? 'justify-center' : 'ms-auto']}>
      <Nav items={items} menu={menu} label={navLabel} menuLabel={menuLabel} closeLabel={closeLabel} part="nav-header" color={linkNav ? 'link' : 'current'} align={layout === 'centered' ? 'center' : 'end'} />
      {action && <Button action={action} size="sm" class="hidden md:inline-flex" />}
    </div>
  </div>
</header>
