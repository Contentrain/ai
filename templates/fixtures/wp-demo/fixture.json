{
  "dependencies": {
    "embla-carousel": "^8.6.0"
  },
  "absentFromDist": [
    "Roadmap draft",
    "/roadmap/",
    "Unannounced plans"
  ],
  "distFiles": {
    "_redirects": {
      "contains": [
        "/old-about/ /about/ 301",
        "/feed/ /rss.xml 301",
        "/gone/ /404.html 410",
        "/team/ /about/team/ 301",
        "/ page_id=302 /contact/ 301",
        "/ page_id=301 /about/team/ 301"
      ],
      "excludes": [
        "/2019/plans/"
      ]
    },
    "old-about/index.html": {
      "contains": [
        "http-equiv=\"refresh\"",
        "/about/"
      ]
    },
    "sitemap-0.xml": {
      "contains": [
        "/about/team/</loc>"
      ],
      "excludes": [
        "/old-about/",
        "/search/"
      ]
    },
    "wp-query-map.json": {
      "contains": [
        "\"302\": \"/contact/\"",
        "\"301\": \"/about/team/\""
      ],
      "excludes": [
        "\"304\""
      ]
    },
    "index.html": {
      "contains": [
        "location.replace(to)"
      ]
    },
    "_headers": {
      "contains": [
        "/media/*.svg",
        "Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
      ]
    }
  }
}
