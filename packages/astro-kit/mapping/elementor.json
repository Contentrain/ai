{
  "format": "astro-kit-mapping@1",
  "builder": "elementor",
  "version": "6",
  "fallback": "prose",
  "defaults": {
    "elementor/video": {
      "video_type": "youtube"
    },
    "elementor/icon-box": {
      "text_align": "center"
    },
    "elementor/image-box": {
      "text_align": "center"
    }
  },
  "rules": [
    {
      "match": "elementor/theme-site-logo",
      "component": "header",
      "props": {
        "siteName": "site:title",
        "logo": "site:logo",
        "items": "menu:primary",
        "navLabel": "ui:nav.label",
        "menuLabel": "ui:nav.menu",
        "closeLabel": "ui:nav.close"
      }
    },
    {
      "match": "elementor/theme-site-title",
      "component": "header",
      "props": {
        "siteName": "site:title",
        "logo": "site:logo",
        "items": "menu:primary",
        "navLabel": "ui:nav.label",
        "menuLabel": "ui:nav.menu",
        "closeLabel": "ui:nav.close"
      }
    },
    {
      "match": "elementor/nav-menu",
      "component": "nav",
      "props": {
        "items": "menu:primary",
        "label": "ui:nav.label",
        "menuLabel": "ui:nav.menu",
        "closeLabel": "ui:nav.close"
      }
    },
    {
      "match": "elementor/social-icons",
      "component": "footer",
      "props": {
        "siteName": "site:title"
      },
      "into": "social",
      "each": ".elementor-social-icon",
      "item": {
        "label": "dom:.elementor-screen-only",
        "href": "dom:@href"
      }
    },
    {
      "match": "elementor/icon-list",
      "component": "footer",
      "props": {
        "siteName": "site:title"
      },
      "into": "links",
      "each": ".elementor-icon-list-item",
      "item": {
        "label": "dom:.elementor-icon-list-text",
        "href": "dom:a@href"
      }
    },
    {
      "match": "elementor/icon-box",
      "component": "card-grid",
      "group": "siblings",
      "into": "items",
      "item": {
        "title": "dom:.elementor-icon-box-title",
        "text": "dom:.elementor-icon-box-description",
        "href": "dom:a@href"
      }
    },
    {
      "match": "elementor/image-box",
      "component": "card-grid",
      "group": "siblings",
      "into": "items",
      "item": {
        "title": "dom:.elementor-image-box-title",
        "text": "dom:.elementor-image-box-description",
        "href": "dom:a@href",
        "image": "img:img@src",
        "imageAlt": "img:img@alt"
      }
    },
    {
      "match": "elementor/call-to-action",
      "component": "cta",
      "variant": {
        "frame": "card"
      },
      "props": {
        "heading": "dom:.elementor-cta__title",
        "body": "dom:.elementor-cta__description"
      },
      "into": "actions",
      "each": ".elementor-cta__button",
      "item": {
        "label": "dom:",
        "href": "dom:@href"
      }
    },
    {
      "match": "elementor/posts",
      "component": "post-card",
      "bind": "collection:posts",
      "item": {
        "title": "field:title",
        "href": "href:self",
        "excerpt": "field:excerpt",
        "date": "field:date",
        "image": "media:featured_image",
        "author": "ref:author.name",
        "category": "term:categories"
      }
    },
    {
      "match": "elementor/archive-posts",
      "component": "post-card",
      "bind": "collection:posts",
      "item": {
        "title": "field:title",
        "href": "href:self",
        "excerpt": "field:excerpt",
        "date": "field:date",
        "image": "media:featured_image",
        "author": "ref:author.name",
        "category": "term:categories"
      }
    },
    {
      "match": "elementor/posts:pagination",
      "component": "pagination",
      "props": {
        "base": "page:base",
        "current": "page:current",
        "total": "page:total",
        "label": "ui:pagination.label",
        "prevLabel": "ui:pagination.prev",
        "nextLabel": "ui:pagination.next",
        "pageLabel": "ui:pagination.page"
      }
    },
    {
      "match": "elementor/breadcrumbs",
      "component": "breadcrumb",
      "props": {
        "items": "page:breadcrumb",
        "current": "field:title",
        "label": "ui:breadcrumb.label"
      }
    },
    {
      "match": "elementor/image-carousel",
      "component": "slider",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": ".swiper-slide:not(.swiper-slide-duplicate)",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "text": "dom:figcaption"
      }
    },
    {
      "match": "elementor/media-carousel",
      "component": "slider",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": ".swiper-slide:not(.swiper-slide-duplicate)",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt"
      }
    },
    {
      "match": "elementor/slides",
      "component": "slider",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": ".swiper-slide:not(.swiper-slide-duplicate)",
      "item": {
        "title": "dom:.elementor-slide-heading",
        "text": "dom:.elementor-slide-description",
        "ctaLabel": "dom:.elementor-slide-button",
        "ctaHref": "dom:.elementor-slide-button@href"
      }
    },
    {
      "match": "elementor/accordion",
      "component": "faq",
      "into": "items",
      "each": ".elementor-accordion-item",
      "item": {
        "question": "dom:.elementor-accordion-title",
        "answer": "html:.elementor-tab-content"
      }
    },
    {
      "match": "elementor/toggle",
      "component": "faq",
      "props": {
        "exclusive": "const:false"
      },
      "into": "items",
      "each": ".elementor-toggle-item",
      "item": {
        "question": "dom:.elementor-toggle-title",
        "answer": "html:.elementor-tab-content"
      }
    },
    {
      "match": "elementor/nested-accordion",
      "component": "faq",
      "into": "items",
      "each": "details",
      "item": {
        "question": "dom:summary",
        "answer": "html::scope > :not(summary)"
      }
    },
    {
      "match": "elementor/tabs",
      "component": "tabs",
      "into": "items",
      "each": ".elementor-tab-desktop-title",
      "item": {
        "label": "dom:",
        "content": "html:.elementor-tab-content"
      }
    },
    {
      "match": "elementor/nested-tabs",
      "component": "tabs",
      "into": "items",
      "each": ".e-n-tab-title",
      "item": {
        "label": "dom:.e-n-tab-title-text",
        "content": "html:.e-con"
      }
    },
    {
      "match": "elementor/testimonial",
      "component": "testimonial",
      "group": "siblings",
      "into": "items",
      "item": {
        "quote": "dom:.elementor-testimonial-content",
        "name": "dom:.elementor-testimonial-name",
        "role": "dom:.elementor-testimonial-job",
        "avatar": "img:.elementor-testimonial-image img@src",
        "avatarAlt": "img:.elementor-testimonial-image img@alt"
      }
    },
    {
      "match": "elementor/image-gallery",
      "component": "gallery",
      "props": {
        "closeLabel": "ui:gallery.close"
      },
      "into": "items",
      "each": ".gallery-item",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "caption": "dom:.gallery-caption"
      }
    },
    {
      "match": "elementor/gallery",
      "component": "gallery",
      "props": {
        "closeLabel": "ui:gallery.close"
      },
      "into": "items",
      "each": ".e-gallery-item",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "caption": "dom:.elementor-gallery-item__title"
      }
    },
    {
      "match": "elementor/form",
      "component": "contact-form",
      "props": {
        "model": "const:contact",
        "heading": "attr:form_name"
      }
    },
    {
      "match": "elementor/text-editor",
      "component": "prose",
      "props": {
        "html": "html:"
      }
    },
    {
      "match": "elementor/theme-post-content",
      "component": "prose",
      "props": {
        "html": "html:"
      }
    },
    {
      "match": "elementor/video",
      "when": {
        "attr": {
          "video_type": "youtube"
        }
      },
      "component": "embed",
      "props": {
        "url": "attr:youtube_url",
        "playLabel": "ui:embed.play",
        "showLabel": "ui:embed.show"
      }
    },
    {
      "match": "elementor/video",
      "when": {
        "attr": {
          "video_type": "vimeo"
        }
      },
      "component": "embed",
      "props": {
        "url": "attr:vimeo_url",
        "playLabel": "ui:embed.play",
        "showLabel": "ui:embed.show"
      }
    },
    {
      "match": "elementor/google_maps",
      "component": "embed",
      "variant": {
        "aspect": "map"
      },
      "props": {
        "address": "attr:address",
        "playLabel": "ui:embed.play",
        "showLabel": "ui:embed.show"
      }
    }
  ],
  "sections": [
    {
      "id": "hero.split",
      "component": "hero",
      "variant": {
        "layout": "split"
      },
      "when": {
        "position": "first",
        "columns": [
          1,
          2
        ]
      },
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1,
          "min": 1,
          "attr": {
            "header_size": "h1|h2"
          }
        },
        "lead": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "button": {
          "match": "elementor/button",
          "max": 2
        },
        "media": {
          "match": "elementor/image",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "lead": "@lead dom:",
        "image": "@media img:img"
      },
      "into": "actions",
      "each": "@button",
      "item": {
        "label": "attr:text || dom:.elementor-button-text",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "hero.centered",
      "component": "hero",
      "variant": {
        "layout": "centered"
      },
      "when": {
        "position": "first",
        "columns": 1
      },
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1,
          "min": 1,
          "attr": {
            "header_size": "h1|h2"
          }
        },
        "lead": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "button": {
          "match": "elementor/button",
          "max": 2
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "lead": "@lead dom:"
      },
      "into": "actions",
      "each": "@button",
      "item": {
        "label": "attr:text || dom:.elementor-button-text",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "announcement.alert",
      "component": "announcement",
      "slots": {
        "alert": {
          "match": "elementor/alert",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "message": "@alert attr:alert_title || @alert dom:.elementor-alert-title"
      }
    },
    {
      "id": "split.image-text",
      "component": "split",
      "when": {
        "columns": 2
      },
      "slots": {
        "media": {
          "match": "elementor/image",
          "min": 1,
          "max": 1
        },
        "title": {
          "match": "elementor/heading",
          "max": 1,
          "min": 1
        },
        "body": {
          "match": [
            "elementor/text-editor",
            "elementor/icon-list"
          ],
          "max": 3
        },
        "button": {
          "match": "elementor/button",
          "max": 2
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "body": "@body html:",
        "image": "@media img:img"
      },
      "into": "actions",
      "each": "@button",
      "item": {
        "label": "attr:text || dom:.elementor-button-text",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "card-grid.icon-box",
      "component": "card-grid",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "box": {
          "match": "elementor/icon-box",
          "min": 2
        }
      },
      "props": {
        "title": "@title attr:title || @title dom:",
        "intro": "@intro dom:"
      },
      "into": "items",
      "each": "@box",
      "item": {
        "title": "attr:title_text || dom:.elementor-icon-box-title",
        "text": "attr:description_text || dom:.elementor-icon-box-description",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "card-grid.image-box",
      "component": "card-grid",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "box": {
          "match": "elementor/image-box",
          "min": 2
        }
      },
      "props": {
        "title": "@title attr:title || @title dom:",
        "intro": "@intro dom:"
      },
      "into": "items",
      "each": "@box",
      "item": {
        "title": "attr:title_text || dom:.elementor-image-box-title",
        "text": "attr:description_text || dom:.elementor-image-box-description",
        "href": "attr:link.url || dom:a@href",
        "image": "attr:image.url || img:img@src",
        "imageAlt": "img:img@alt"
      }
    },
    {
      "id": "stats.counter",
      "component": "stats",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "counter": {
          "match": "elementor/counter",
          "min": 2
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "intro": "@intro dom:"
      },
      "into": "items",
      "each": "@counter",
      "item": {
        "value": "attr:ending_number || dom:.elementor-counter-number",
        "label": "attr:title || dom:.elementor-counter-title",
        "prefix": "attr:prefix || dom:.elementor-counter-number-prefix",
        "suffix": "attr:suffix || dom:.elementor-counter-number-suffix"
      }
    },
    {
      "id": "pricing.price-table",
      "component": "pricing",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "plan": {
          "match": "elementor/price-table",
          "min": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "intro": "@intro dom:"
      },
      "into": "plans",
      "each": "@plan",
      "item": {
        "name": "attr:heading || dom:.elementor-price-table__heading",
        "price": "dom:.elementor-price-table__price || attr:price",
        "period": "attr:period || dom:.elementor-price-table__period",
        "description": "attr:sub_heading || dom:.elementor-price-table__subheading",
        "features": "html:.elementor-price-table__features-list",
        "ctaLabel": "attr:button_text || dom:.elementor-price-table__button",
        "ctaHref": "attr:link.url || dom:.elementor-price-table__button@href"
      }
    },
    {
      "id": "logo-cloud.images",
      "component": "logo-cloud",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "logo": {
          "match": "elementor/image",
          "min": 3
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:"
      },
      "into": "items",
      "each": "@logo",
      "item": {
        "image": "attr:image.url || img:img@src",
        "imageAlt": "img:img@alt",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "testimonial.quotes",
      "component": "testimonial",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "quote": {
          "match": "elementor/testimonial",
          "min": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:"
      },
      "into": "items",
      "each": "@quote",
      "item": {
        "quote": "attr:testimonial_content || dom:.elementor-testimonial-content",
        "name": "attr:testimonial_name || dom:.elementor-testimonial-name",
        "role": "attr:testimonial_job || dom:.elementor-testimonial-job",
        "avatar": "attr:testimonial_image.url || img:.elementor-testimonial-image img@src",
        "avatarAlt": "img:.elementor-testimonial-image img@alt"
      }
    },
    {
      "id": "faq.accordion",
      "component": "faq",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "faq": {
          "match": "elementor/accordion",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:"
      },
      "into": "items",
      "each": "@faq .elementor-accordion-item",
      "item": {
        "question": "dom:.elementor-accordion-title",
        "answer": "html:.elementor-tab-content"
      }
    },
    {
      "id": "faq.toggle",
      "component": "faq",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "faq": {
          "match": "elementor/toggle",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "exclusive": "const:false"
      },
      "into": "items",
      "each": "@faq .elementor-toggle-item",
      "item": {
        "question": "dom:.elementor-toggle-title",
        "answer": "html:.elementor-tab-content"
      }
    },
    {
      "id": "faq.nested",
      "component": "faq",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "faq": {
          "match": "elementor/nested-accordion",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:"
      },
      "into": "items",
      "each": "@faq details",
      "item": {
        "question": "dom:summary",
        "answer": "html::scope > :not(summary)"
      }
    },
    {
      "id": "gallery.image-gallery",
      "component": "gallery",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "images": {
          "match": "elementor/image-gallery",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "closeLabel": "ui:gallery.close"
      },
      "into": "items",
      "each": "@images .gallery-item",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "caption": "dom:.gallery-caption"
      }
    },
    {
      "id": "gallery.pro",
      "component": "gallery",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "images": {
          "match": "elementor/gallery",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "closeLabel": "ui:gallery.close"
      },
      "into": "items",
      "each": "@images .e-gallery-item",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "caption": "dom:.elementor-gallery-item__title"
      }
    },
    {
      "id": "slider.carousel",
      "component": "slider",
      "slots": {
        "slides": {
          "match": [
            "elementor/image-carousel",
            "elementor/media-carousel"
          ],
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": "@slides .swiper-slide:not(.swiper-slide-duplicate)",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "text": "dom:figcaption"
      }
    },
    {
      "id": "contact-form.form",
      "component": "contact-form",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "form": {
          "match": "elementor/form",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "model": "const:contact",
        "heading": "@title attr:title || @title dom: || @form attr:form_name",
        "intro": "@intro dom:"
      }
    },
    {
      "id": "cta.text-button",
      "component": "cta",
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1,
          "min": 1
        },
        "body": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "button": {
          "match": "elementor/button",
          "min": 1,
          "max": 2
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "body": "@body dom:"
      },
      "into": "actions",
      "each": "@button",
      "item": {
        "label": "attr:text || dom:.elementor-button-text",
        "href": "attr:link.url || dom:a@href"
      }
    },
    {
      "id": "feature-list.icon-list",
      "component": "feature-list",
      "variant": {
        "style": "icon"
      },
      "slots": {
        "title": {
          "match": "elementor/heading",
          "max": 1
        },
        "intro": {
          "match": "elementor/text-editor",
          "max": 1
        },
        "list": {
          "match": "elementor/icon-list",
          "min": 1,
          "max": 1
        }
      },
      "props": {
        "heading": "@title attr:title || @title dom:",
        "intro": "@intro dom:"
      },
      "into": "items",
      "each": "@list .elementor-icon-list-item",
      "item": {
        "title": "dom:.elementor-icon-list-text"
      }
    }
  ]
}
