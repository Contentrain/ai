          "options": [
            "1",
            "2",
            "3"
          ],
          "default": "1",
          "description": "Slides visible at once on wide screens."
        },
        "aspect": {
          "options": [
            "wide",
            "standard",
            "square"
          ],
          "default": "wide",
          "description": "Image aspect ratio: 21:9, 3:2 or 1:1."
        },
        "caption": {
          "options": [
            "below",
            "overlay"
          ],
          "default": "overlay",
          "description": "Caption under the image, or over its lower edge on a gradient."
        }
      },
      "props": {
        "slides": {
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "fields": {
              "image": {
                "type": "object",
                "required": true
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "text"
              },
              "action": {
                "type": "object"
              }
            }
          },
          "description": "Slides; image is an ImageInput, action an ActionInput."
        },
        "label": {
          "type": "string",
          "required": true,
          "description": "Accessible name of the carousel."
        },
        "prevLabel": {
          "type": "string",
          "description": "ui-strings slider.prev."
        },
        "nextLabel": {
          "type": "string",
          "description": "ui-strings slider.next."
        },
        "slideLabel": {
          "type": "string",
          "description": "ui-strings slider.slide."
        },
        "ofLabel": {
          "type": "string",
