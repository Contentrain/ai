{
  "id": "blog-post",
  "name": "Blog Post",
  "kind": "document",
  "domain": "blog",
  "i18n": true,
  "title_field": "title",
  "fields": {
    "cover": {
      "type": "image"
    },
    "excerpt": {
      "max": 280,
      "type": "text"
    },
    "slug": {
      "required": true,
      "type": "slug",
      "unique": true
    },
    "tags": {
      "items": "string",
      "type": "array"
    },
    "title": {
      "max": 120,
      "required": true,
      "type": "string"
    }
  }
}
