---
// A public form. By default it is served by Contentrain Studio: the fields,
// honeypot and captcha come from the model's form settings in Studio, so an
// editor changes the form without touching code; submissions arrive in Studio
// for review. Until the site is bound to a Studio project (site.config.ts) it
// shows the source's address to write to, and when there is none it says so in
// the form's place (`needs_endpoint`: its fields as text and a line that it
// needs Studio or a form endpoint) — no script, never a form that vanishes.
// When the owner chose another home at migration (site.config.ts
// `features.forms`), it posts to their form service, shows an address to write
// to, or links to the form on the WordPress site: a live link, with a line
// saying where it is sent.
import { getStringTable } from '../../lib/content'
import { formAddress, formFields, formHome, onWordPress } from '../../lib/features'
import { siteConfig } from '../../site.config'
import FormMount from './FormMount.astro'
import StaticForm from './StaticForm.astro'
import { safeHref } from '../kit/_shared/safe-url'

interface Props {
  /** The model submissions are saved to. */
  model: string
  class?: string
}

const { model, class: className } = Astro.props
const studio = siteConfig.studio
const forms = siteConfig.features?.forms
const home = formHome(model)
const text = home ? await getStringTable(['common.', 'form.']) : {}
const wordpress = home === 'wordpress' ? onWordPress(Astro.url.pathname) : undefined
const address = home === 'mailto' ? formAddress() : undefined
const fields = home === 'needs_endpoint' ? formFields(model) : []
const host = wordpress ? new URL(wordpress).host : ''
const noteId = `cr-form-note-${model.replace(/[^\w-]/g, '-')}`
---
{home === 'studio' && studio && <FormMount baseUrl={studio.baseUrl} projectId={studio.projectId} model={model} text={text} class={className} />}
{home === 'endpoint' && forms?.home === 'endpoint' && <StaticForm model={model} action={forms.action} text={text} class={className} />}
{address && (
  <p class:list={['cr-form-mount', className]} data-cr-part="form" data-state="mailto">
    {text['form.mailto'] ?? 'Write to us at'} <a href={`mailto:${encodeURI(address)}`} class="underline underline-offset-4">{address}</a>
  </p>
)}
{wordpress && (
  <div class:list={['cr-form-mount block', className]} data-cr-part="form" data-state="wordpress">
    <p class="cr-form-note" id={noteId}>{(text['form.wordpress_note'] ?? 'This form is sent on {site}.').replace('{site}', host)}</p>
    <p class="cr-actions"><a href={safeHref(wordpress)} class="cr-form-link" aria-describedby={noteId}>{text['form.wordpress'] ?? 'Open the form'}</a></p>
  </div>
)}
{home === 'needs_endpoint' && (
  <div class:list={['cr-form-mount block', className]} data-cr-part="form" data-state="needs_endpoint" data-model={model}>
    {fields.length > 0 && <ul class="cr-form-fields">{fields.map(field => <li>{field.def.label ?? field.id}</li>)}</ul>}
    <p class="cr-form-note" role="note">{text['form.needs_endpoint'] ?? 'This form needs Studio or a form endpoint to receive messages.'}</p>
  </div>
)}
