---
// The page's opening section: heading, lead, points, actions and an image — beside the
// text, below it, or behind it as a cover with the text over a scrim.
import { tv } from 'tailwind-variants'
import Button from '../_shared/Button.astro'
import KitImage from '../_shared/KitImage.astro'
import Section from '../_shared/Section.astro'
import Lines from '../_shared/Lines.astro'
import { instanceId } from '../_shared/instance-id'
import type { ActionInput, ImageInput, MeasuredStyle } from '../_shared/types'
import { measuredFrame } from '../_shared/measured'
import { coverHeight as heightOf, headingStyle as styleOf } from './hero'
import { muted, mutedInverse } from '../_shared/muted'
import { BLEED } from '../_shared/bleed'

const hero = tv({
  slots: {
    grid: 'grid items-center gap-10',
    copy: 'flex flex-col gap-5',
    eyebrow: `text-sm font-semibold tracking-wide uppercase ${muted}`,
    heading: 'text-4xl [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance md:text-5xl lg:text-6xl',
    lead: `max-w-2xl text-lg text-pretty ${muted} md:text-xl`,
    // A hero's short promise list ("Fast, easy and painless"), each with its icon when it has one.
    points: 'flex flex-wrap gap-x-6 gap-y-2 text-base font-medium md:text-lg',
    point: 'flex items-center gap-2',
    actions: 'flex flex-wrap gap-3 pt-2',
    media: 'overflow-hidden rounded-[var(--radius-image,var(--radius-card))]',
  },
  variants: {
    layout: {
      split: { grid: 'md:grid-cols-2' },
      centered: { copy: 'items-center text-center', lead: 'mx-auto', points: 'justify-center', actions: 'justify-center', media: 'mx-auto w-full max-w-4xl' },
      cover: { grid: 'relative z-10 min-h-[28rem] md:min-h-[36rem]', copy: 'max-w-3xl' },
    },
    // accent/accent-ink is only ~5:1 — dimming text on it drops body copy under 4.5:1 (WCAG 1.4.3), so accent keeps it at full strength.
    tone: { default: {}, muted: {}, inverse: {}, accent: {} },
    // Where a cover sets its text over the image. WordPress covers centre it unless told otherwise.
    align: { start: {}, center: {} },
    // The lead's own alignment: `start` keeps it at the start edge, across the column, under a centred heading
    // (Hello centres the heading widget and leaves the text editor left in the same container).
    leadAlign: { inherit: {}, start: {} },
    // The buttons' own alignment: `start` keeps them at the start edge under centred text (a WordPress buttons block
    // with no justification sits left inside a cover whose heading and paragraph are centred).
    actionsAlign: { inherit: {}, start: {} },
    // How wide a cover runs: the full window, or the reading column — a WordPress cover block that is not
    // alignfull sits in the content column, the page title above it.
    width: { full: {}, content: {} },
    // The heading's size: the layout's own scale, or the site's size for its level (set inline, see ./hero).
    headingScale: { default: {}, theme: {} },
    // The level whose site size the heading takes when it is not the level it is written at (set inline, see ./hero).
    headingSize: { own: {}, h1: {}, h2: {} },
    // The heading as the author broke it: `lines` prints each `\n`-separated line as its own block (`data-kit-line`),
    // `flow` (the default) as one run of text.
    headingLines: { flow: {}, lines: {} },
    // Split and centered (a cover ignores both): the image before the text, on phones and on the start side (split),
    // or above the heading (centered).
    stackOrder: { 'text-first': {}, 'media-first': { media: 'order-first' } },
    // edge: the image runs on to the window's edge on its side (wide screens), or across the whole width when centered.
    // overlap: it also crosses the section's bottom edge by `--hero-overlap` (3rem), drawn over the next section's top
    // padding: set at the grid's bottom and moved past the hero's own bottom padding (`spacing="lg"`: 4rem, 7rem from md),
    // not laid out there, so the next section stays where it was. Only an image that comes last can cross the bottom: one
    // that comes first (`media-first`) would be moved down over the text, so there overlap draws as edge.
    // Centered only (split and cover ignore it): from md the copy's start edge sits at this share of the frame's width,
    // its text at that edge; below md it is centred, as without it.
    inset: { none: {}, '15': {}, '27': {}, '34': {}, '42': {} },
    imageBleed: { none: {}, edge: { media: 'rounded-none' }, overlap: { media: 'relative z-10 self-end translate-y-[calc(4rem+var(--hero-overlap,3rem))] rounded-none md:translate-y-[calc(7rem+var(--hero-overlap,3rem))]' } },
  },
  compoundVariants: [
    // After the layout's own heights, so a boxed cover keeps WordPress's 430px default.
    { layout: 'cover', width: 'content', class: { grid: 'min-h-[20rem] md:min-h-[26.875rem]' } },
    { layout: 'cover', align: 'center', class: { grid: 'justify-items-center', copy: 'mx-auto items-center text-center', lead: 'mx-auto', points: 'justify-center', actions: 'justify-center' } },
    // After the centring rules, so the lead leaves them.
    { leadAlign: 'start', class: { lead: 'mx-0 max-w-none self-stretch text-start' } },
    { actionsAlign: 'start', class: { actions: 'justify-start self-stretch' } },
    // After the centring rules, so the copy leaves them from md.
    { layout: 'centered', inset: ['15', '27', '34', '42'], class: { copy: 'md:items-start md:text-start', lead: 'md:mx-0', points: 'md:justify-start', actions: 'md:justify-start' } },
    { layout: 'centered', inset: '15', class: { copy: 'md:ms-[15%]' } },
    { layout: 'centered', inset: '27', class: { copy: 'md:ms-[27%]' } },
    { layout: 'centered', inset: '34', class: { copy: 'md:ms-[34%]' } },
    { layout: 'centered', inset: '42', class: { copy: 'md:ms-[42%]' } },
  ],
  defaultVariants: { layout: 'split', tone: 'default', align: 'center', leadAlign: 'inherit', actionsAlign: 'inherit', width: 'full', headingScale: 'default', headingSize: 'own', headingLines: 'flow', stackOrder: 'text-first', inset: 'none', imageBleed: 'none' },
})

interface Props {
  heading: string
  /** Heading level: 1 when the hero opens the page (the default), 2 inside a page that already has one. */
  level?: 1 | 2 | undefined
  eyebrow?: string | undefined
  lead?: string | undefined
  /** Short points under the lead, before the buttons: a promise or feature list, each with an optional icon (an image address). */
  items?: Array<{ title: string, icon?: string | undefined }> | undefined
  actions?: ActionInput[] | undefined
  image?: ImageInput | undefined
  layout?: 'split' | 'centered' | 'cover' | undefined
  /** Text position over a cover image; other layouts ignore it. */
  align?: 'start' | 'center' | undefined
  /** The lead's alignment: as the layout sets it, or at the start edge under a centred heading. */
  leadAlign?: 'inherit' | 'start' | undefined
  /** The buttons' alignment: as the layout sets it, or at the start edge under centred text. */
  actionsAlign?: 'inherit' | 'start' | undefined
  /** A cover's width: the full window (the default) or the reading column; other layouts ignore it. */
  width?: 'full' | 'content' | undefined
  tone?: 'default' | 'muted' | 'inverse' | 'accent' | undefined
  id?: string | undefined
  /** A cover's own height in pixels, as the source sets it (`520`); absent, the layout's default. Layout cover only. */
  minHeight?: number | undefined
  /** `theme`: the heading takes the site's size for its level (the source's own `h1` size), not the layout's scale. */
  headingScale?: 'default' | 'theme' | undefined
  /** The level whose site size the heading takes, when it is not the level it is written at (`h1` size on an `h2`: a page keeps one `h1`). `own` (absent): the heading's own level under `theme`, as before. */
  headingSize?: 'own' | 'h1' | 'h2' | undefined
  /** `lines`: each line of the heading (split at `\n`) is a block of its own, `data-kit-line="<n>"`, for a theme to set per line. `flow` (absent): one run of text, as before. */
  headingLines?: 'flow' | 'lines' | undefined
  /** Split and centered: `media-first` puts the image before the text (phones and the start side in split, above the heading in centered). `text-first` (absent): as before. */
  stackOrder?: 'text-first' | 'media-first' | undefined
  /** Split and centered: `edge` runs the image on to the window's edge on its side (both sides when centered); `overlap` also lets it cross the section's bottom edge by `--hero-overlap` (3rem), when the image comes last (with `media-first` it draws as `edge`). `none` (absent): as before. */
  imageBleed?: 'none' | 'edge' | 'overlap' | undefined
  /** Centered only: from md the copy starts at this share of the frame's width (`15` … `42` %), its text at that edge. `none` (absent): as before. */
  inset?: 'none' | '15' | '27' | '34' | '42' | undefined
  /** The source section's measured style (`MeasuredStyle`): frame, padding, fill, background image, columns per width, gap. Absent, the site's tokens; present, it wins over tone and columns. */
  measured?: MeasuredStyle | undefined
}


const { heading, level = 1, eyebrow, lead, items = [], actions = [], image, layout = 'split', align, leadAlign, actionsAlign, width = 'full', tone, id: givenId, minHeight, headingScale, headingSize, headingLines, stackOrder, imageBleed, inset, measured } = Astro.props
// Every section has an id, so a theme or a design layer can address this one: the page's, or `hero`, `hero-2`, … in render order.
const id = instanceId(Astro.locals, givenId, 'hero')
// Overlap moves the image down past the section's bottom, so only an image that comes last may: first, it is edge.
const bleedAs = imageBleed === 'overlap' && stackOrder === 'media-first' ? 'edge' : imageBleed
const s = hero({ layout, align, leadAlign, actionsAlign, width, tone, headingScale, headingSize, headingLines, stackOrder, inset, imageBleed: bleedAs })
const Heading = level === 1 ? 'h1' : 'h2'
const headingId = `${id}-title`
const cover = layout === 'cover' && image
const coverHeight = cover ? heightOf(minHeight) : undefined
const headingStyle = styleOf(headingScale, level, headingSize)
// A cover draws its own image: the measured background image is that image, and the measured overlay is its scrim.
const sectionMeasured = cover && measured ? { ...measured, bg: measured.bg ? { ...measured.bg, image: undefined, overlay: undefined } : undefined } : measured
const scrim = cover ? measuredFrame(measured).overlay : undefined
// The window's edge for a bleeding image: its own side in split (the start side when it comes first), both when centered.
const bleeds = !cover && image && imageBleed !== undefined && imageBleed !== 'none'
const bleed = bleeds ? (layout === 'centered' ? `max-w-none md:w-auto ${BLEED.start} ${BLEED.end}` : BLEED[stackOrder === 'media-first' ? 'start' : 'end']) : undefined
---
{cover && width === 'content'
  ? (
    <Section kit="hero" measured={sectionMeasured} tone="none" spacing="sm" width="prose" id={id} aria-labelledby={headingId}>
      <div class={`relative isolate overflow-hidden bg-ink text-surface ${mutedInverse}`}>
        <KitImage image={image} priority sizes="(min-width: 768px) 46rem, 100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
        <div class:list={['absolute inset-0 -z-10', !scrim && 'bg-ink/60']} style={scrim ? `background: ${scrim}` : undefined} aria-hidden="true" />
        <div class="px-6 py-10 md:px-10">
          <div class={s.grid()} style={coverHeight ? `min-height: ${coverHeight}` : undefined}>
            <div class={s.copy()}>
              {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
              <Heading id={headingId} class={s.heading()} style={headingStyle}>{headingLines === 'lines' ? <Lines text={heading} /> : heading}</Heading>
              {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
              {items.length > 0 && <ul class={s.points()}>{items.map(item => <li class={s.point()}>{item.icon && <KitImage image={{ src: item.icon, alt: '' }} class="h-6 w-6 shrink-0 object-contain" />}<span>{item.title}</span></li>)}</ul>}
              {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
            </div>
          </div>
        </div>
      </div>
    </Section>
  )
  : cover
  ? (
    <Section kit="hero" measured={sectionMeasured} tone="inverse" spacing="none" width="none" id={id} aria-labelledby={headingId} class="relative isolate overflow-hidden">
      <KitImage image={image} priority sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class:list={['absolute inset-0 -z-10', !scrim && 'bg-ink/60']} style={scrim ? `background: ${scrim}` : undefined} aria-hidden="true" />
      <div class:list={['container-page', measured?.padY === undefined && 'py-16 md:py-28']}>
        <div class={s.grid()} style={coverHeight ? `min-height: ${coverHeight}` : undefined}>
          <div class={s.copy()}>
            {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
            <Heading id={headingId} class={s.heading()} style={headingStyle}>{headingLines === 'lines' ? <Lines text={heading} /> : heading}</Heading>
            {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
              {items.length > 0 && <ul class={s.points()}>{items.map(item => <li class={s.point()}>{item.icon && <KitImage image={{ src: item.icon, alt: '' }} class="h-6 w-6 shrink-0 object-contain" />}<span>{item.title}</span></li>)}</ul>}
            {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
          </div>
        </div>
      </div>
    </Section>
  )
  : (
    <Section kit="hero" measured={sectionMeasured} tone={tone} spacing="lg" id={id} aria-labelledby={headingId} class={bleeds ? 'overflow-x-clip' : undefined}>
      {/* Without an image a split has nothing beside the text: the text takes the whole row, not half of it. */}
      <div class={s.grid({ class: image ? undefined : 'md:grid-cols-1' })}>
        <div class={s.copy()}>
          {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
          <Heading id={headingId} class={s.heading()} style={headingStyle}>{headingLines === 'lines' ? <Lines text={heading} /> : heading}</Heading>
          {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
              {items.length > 0 && <ul class={s.points()}>{items.map(item => <li class={s.point()}>{item.icon && <KitImage image={{ src: item.icon, alt: '' }} class="h-6 w-6 shrink-0 object-contain" />}<span>{item.title}</span></li>)}</ul>}
          {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
        </div>
        {image && (
          <div class:list={[s.media(), bleed]}>
            <KitImage image={image} priority sizes={layout === 'split' ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 1024px) 56rem, 100vw'} class="h-auto w-full object-cover" />
          </div>
        )}
      </div>
    </Section>
  )}
