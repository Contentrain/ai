---
// A paginated list of posts: the blog index and the category, tag and author
// archives — as cards (a grid, or one column), or each post in full (siteConfig.lists.display), as the
// source's query loop showed them.
import { getEntry } from 'astro:content'
import KitImage from '../components/kit/_shared/KitImage.astro'
import Pagination from '../components/kit/pagination/Pagination.astro'
import Prose from '../components/kit/prose/Prose.astro'
import PostCard from '../components/kit/post-card/PostCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { byId, getSite, getStrings, imageOf, postHref, termHref, type Post } from '../lib/content'
import { publicHtml } from '../lib/links'
import { collectionLd } from '../lib/seo'
import { siteConfig } from '../site.config'

interface Props {
  /** The archive's heading; the blog index on the front page has none. */
  title?: string | undefined
  /** What kind of archive this is, shown above the title ("Category"). */
  eyebrow?: string | undefined
  description?: string | undefined
  posts: Post[]
  base: string
  current: number
  total: number
}

const { title, eyebrow, description, posts, base, current, total } = Astro.props
const [site, t, categories] = await Promise.all([getSite(), getStrings(), byId('categories')])
const full = siteConfig.lists.display === 'full'
const column = full || siteConfig.lists.display === 'list'
const bodies = full ? await Promise.all(posts.map(post => publicHtml(post.data.body))) : []
const showHeading = Boolean(title) || siteConfig.lists.heading
const cards = await Promise.all(posts.map(async (post) => {
  const cover = post.data.cover ? await getEntry(post.data.cover) : undefined
  const category = post.data.categories[0] ? categories.get(post.data.categories[0].id) : undefined
  return {
    title: post.data.title,
    href: postHref(post),
    excerpt: post.data.excerpt,
    date: post.data.published_at,
    image: cover ? imageOf(cover) : undefined,
    category: category ? { label: category.data.name, href: termHref('category', category, categories) } : undefined,
  }
}))
const pageSuffix = current > 1 ? ` – ${t('pagination.page')} ${current}` : ''
const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
---
<BaseLayout
  title={title ? `${title}${pageSuffix}` : current > 1 ? `${t('blog.title')}${pageSuffix}` : undefined}
  description={description}
  jsonLd={[collectionLd(url, title ?? t('blog.title'))]}
>
  <div class="container-page py-12 md:py-16">
    <header class:list={['mb-12 flex flex-col gap-3', column ? 'mx-auto max-w-(--container-prose)' : 'max-w-2xl', !showHeading && 'sr-only']}>
      {eyebrow && <p class="text-sm font-medium tracking-wide text-accent uppercase">{eyebrow}</p>}
      <h1 class="text-4xl [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance">{title ?? (siteConfig.lists.heading ? t('blog.title') : site.title)}</h1>
      {description && <p class="text-lg text-ink-muted">{description}</p>}
    </header>
    {cards.length === 0 && <p class="text-ink-muted">{t('blog.empty')}</p>}
    {cards.length > 0 && !full && (
      <div class:list={['grid gap-x-8 gap-y-12', column ? 'mx-auto w-full max-w-(--container-prose)' : 'sm:grid-cols-2 lg:grid-cols-3']}>
        {cards.map(card => <PostCard {...card} locale={site.language ?? 'en'} linkTitle={siteConfig.chrome?.titleLinks} />)}
      </div>
    )}
    {cards.length > 0 && full && (
      <div class="mx-auto flex max-w-(--container-prose) flex-col gap-24" style={siteConfig.lists.text ? `--text-body: ${siteConfig.lists.text}` : undefined}>
        {cards.map((card, index) => (
          <article class="flex flex-col gap-6">
            {card.image && <a href={card.href} tabindex="-1" aria-hidden="true"><KitImage image={{ ...card.image, alt: '' }} priority={index === 0} sizes="(min-width: 768px) 46rem, 100vw" class="h-auto w-full rounded-[var(--radius-image,0.75rem)] object-cover" /></a>}
            <h2 class="text-3xl leading-tight [font-weight:var(--font-weight-heading,700)] tracking-tight"><a href={card.href} class:list={[siteConfig.chrome?.titleLinks ? 'text-[color:var(--color-link,var(--color-accent))]' : 'text-ink', 'no-underline hover:underline']}>{card.title}</a></h2>
            {bodies[index] && <Prose html={bodies[index]} searchable={false} />}
            {card.date && <time datetime={card.date.toISOString()} class="text-sm text-ink-muted">{card.date.toLocaleDateString(site.language ?? 'en', { dateStyle: 'long', timeZone: 'UTC' })}</time>}
          </article>
        ))}
      </div>
    )}
    <Pagination base={base} current={current} total={total} label={t('pagination.label')} prevLabel={t('pagination.prev')} nextLabel={t('pagination.next')} pageLabel={t('pagination.page')} />
  </div>
</BaseLayout>
