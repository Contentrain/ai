{
  "siteConfig": [
    {
      "from": "  sourceHosts: [],",
      "to": "  features: { wordpress: 'https://old.example', forms: { home: 'wordpress' }, chromeForms: [{ role: 'newsletter', path: '/' }, { role: 'contact', path: '/support/', on: ['/write-to-us/'] }] },\n  sourceHosts: [],"
    }
  ],
  "distFiles": {
    "write-to-us/index.html": {
      "contains": [
        "data-cr-part=\"form\" data-state=\"wordpress\" data-model=\"contact-messages\"",
        "This form is sent on old.example.",
        "<a href=\"https://old.example/contact-us/\" class=\"cr-form-link\"",
        "Subscribe on old.example",
        "<a href=\"https://old.example/support/\" class=\"cr-form-link\""
      ],
      "excludes": [
        "<fieldset",
        "disabled",
        "<cr-form",
        "method=\"post\"",
        "needs_endpoint",
        "old.example/write-to-us/"
      ]
    },
    "index.html": {
      "contains": [
        "href=\"https://old.example/\"",
        "Subscribe on old.example"
      ],
      "excludes": [
        "old.example/support/"
      ]
    }
  }
}
