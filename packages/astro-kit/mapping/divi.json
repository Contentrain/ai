{
  "format": "astro-kit-mapping@1",
  "builder": "divi",
  "version": "5",
  "fallback": "prose",
  "rules": [
    {
      "match": "divi/et_pb_menu",
      "component": "header",
      "props": {
        "siteName": "site:title",
        "logo": "site:logo",
        "items": "menu:primary",
        "navLabel": "ui:nav.label",
        "menuLabel": "ui:nav.menu",
        "closeLabel": "ui:nav.close"
      }
    },
    {
      "match": "divi/et_pb_fullwidth_menu",
      "component": "nav",
      "props": {
        "items": "menu:primary",
        "label": "ui:nav.label",
        "menuLabel": "ui:nav.menu",
        "closeLabel": "ui:nav.close"
      }
    },
    {
      "match": "divi/et_pb_social_media_follow",
      "component": "footer",
      "props": {
        "siteName": "site:title"
      },
      "into": "social",
      "each": ".et_pb_social_icon",
      "item": {
        "label": "dom:a@title",
        "href": "dom:a@href"
      }
    },
    {
      "match": "divi/et_pb_blurb",
      "component": "card-grid",
      "group": "siblings",
      "into": "items",
      "item": {
        "title": "dom:.et_pb_module_header",
        "text": "dom:.et_pb_blurb_description",
        "href": "dom:.et_pb_module_header a@href",
        "image": "img:.et_pb_main_blurb_image img@src",
        "imageAlt": "img:.et_pb_main_blurb_image img@alt"
      }
    },
    {
      "match": "divi/et_pb_team_member",
      "component": "card-grid",
      "group": "siblings",
      "into": "items",
      "item": {
        "title": "dom:.et_pb_module_header",
        "eyebrow": "dom:.et_pb_member_position",
        "text": "dom:.et_pb_team_member_description",
        "image": "img:.et_pb_team_member_image img@src",
        "imageAlt": "img:.et_pb_team_member_image img@alt"
      }
    },
    {
      "match": "divi/et_pb_pricing_tables",
      "component": "card-grid",
      "variant": {
        "style": "bordered"
      },
      "into": "items",
      "each": ".et_pb_pricing_table",
      "item": {
        "title": "dom:.et_pb_pricing_title",
        "eyebrow": "dom:.et_pb_sum",
        "text": "dom:.et_pb_pricing_content",
        "href": "dom:a.et_pb_pricing_table_button@href"
      }
    },
    {
      "match": "divi/et_pb_blog",
      "component": "post-card",
      "bind": "collection:posts",
      "item": {
        "title": "field:title",
        "href": "href:self",
        "excerpt": "field:excerpt",
        "date": "field:date",
        "image": "media:featured_image",
        "author": "ref:author.name",
        "category": "term:categories"
      }
    },
    {
      "match": "divi/et_pb_blog:pagination",
      "component": "pagination",
      "props": {
        "base": "page:base",
        "current": "page:current",
        "total": "page:total",
        "label": "ui:pagination.label",
        "prevLabel": "ui:pagination.prev",
        "nextLabel": "ui:pagination.next",
        "pageLabel": "ui:pagination.page"
      }
    },
    {
      "match": "divi/et_pb_breadcrumbs",
      "component": "breadcrumb",
      "props": {
        "items": "page:breadcrumb",
        "current": "field:title",
        "label": "ui:breadcrumb.label"
      }
    },
    {
      "match": "divi/et_pb_slider",
      "component": "slider",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": ".et_pb_slide",
      "item": {
        "title": "dom:.et_pb_slide_title",
        "text": "dom:.et_pb_slide_content",
        "ctaLabel": "dom:.et_pb_more_button",
        "ctaHref": "dom:.et_pb_more_button@href",
        "image": "img:.et_pb_slide_image img@src",
        "imageAlt": "img:.et_pb_slide_image img@alt"
      }
    },
    {
      "match": "divi/et_pb_fullwidth_slider",
      "component": "slider",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "each": ".et_pb_slide",
      "item": {
        "title": "dom:.et_pb_slide_title",
        "text": "dom:.et_pb_slide_content",
        "ctaLabel": "dom:.et_pb_more_button",
        "ctaHref": "dom:.et_pb_more_button@href",
        "image": "img:.et_pb_slide_image img@src",
        "imageAlt": "img:.et_pb_slide_image img@alt"
      }
    },
    {
      "match": "divi/et_pb_post_slider",
      "component": "slider",
      "bind": "collection:posts",
      "props": {
        "label": "ui:slider.label",
        "prevLabel": "ui:slider.prev",
        "nextLabel": "ui:slider.next",
        "slideLabel": "ui:slider.slide",
        "ofLabel": "ui:slider.of"
      },
      "into": "slides",
      "item": {
        "title": "field:title",
        "text": "field:excerpt",
        "image": "media:featured_image"
      }
    },
    {
      "match": "divi/et_pb_fullwidth_header",
      "component": "hero",
      "props": {
        "heading": "dom:.et_pb_module_header",
        "eyebrow": "dom:.et_pb_fullwidth_header_subhead",
        "lead": "dom:.et_pb_header_content_wrapper",
        "image": "img:.header-image img"
      },
      "into": "actions",
      "each": ".et_pb_button",
      "item": {
        "label": "dom:",
        "href": "dom:@href"
      }
    },
    {
      "match": "divi/et_pb_fullwidth_image",
      "component": "hero",
      "variant": {
        "layout": "cover"
      },
      "props": {
        "heading": "attr:title_text",
        "image": "img:img"
      }
    },
    {
      "match": "divi/et_pb_cta",
      "component": "cta",
      "props": {
        "heading": "dom:.et_pb_module_header",
        "body": "dom:.et_pb_promo_description > div"
      },
      "into": "actions",
      "each": ".et_pb_promo_button",
      "item": {
        "label": "dom:",
        "href": "dom:@href"
      }
    },
    {
      "match": "divi/et_pb_accordion",
      "component": "faq",
      "into": "items",
      "each": ".et_pb_accordion_item",
      "item": {
        "question": "dom:.et_pb_toggle_title",
        "answer": "html:.et_pb_toggle_content"
      }
    },
    {
      "match": "divi/et_pb_toggle",
      "component": "faq",
      "props": {
        "exclusive": "const:false"
      },
      "group": "siblings",
      "into": "items",
      "item": {
        "question": "dom:.et_pb_toggle_title",
        "answer": "html:.et_pb_toggle_content"
      }
    },
    {
      "match": "divi/et_pb_tabs",
      "component": "tabs",
      "into": "items",
      "each": ".et_pb_tabs_controls li",
      "item": {
        "label": "dom:a",
        "content": "html:.et_pb_tab"
      }
    },
    {
      "match": "divi/et_pb_testimonial",
      "component": "testimonial",
      "group": "siblings",
      "into": "items",
      "item": {
        "quote": "dom:.et_pb_testimonial_content",
        "name": "dom:.et_pb_testimonial_author",
        "role": "dom:.et_pb_testimonial_position",
        "avatar": "img:.et_pb_testimonial_portrait img@src",
        "avatarAlt": "img:.et_pb_testimonial_portrait img@alt"
      }
    },
    {
      "match": "divi/et_pb_gallery",
      "component": "gallery",
      "props": {
        "closeLabel": "ui:gallery.close"
      },
      "into": "items",
      "each": ".et_pb_gallery_item",
      "item": {
        "image": "img:img@src",
        "imageAlt": "img:img@alt",
        "caption": "dom:.et_pb_gallery_caption"
      }
    },
    {
      "match": "divi/et_pb_contact_form",
      "component": "contact-form",
      "props": {
        "model": "const:contact",
        "heading": "dom:.et_pb_contact_main_title"
      }
    },
    {
      "match": "divi/et_pb_text",
      "component": "prose",
      "props": {
        "html": "html:"
      }
    },
    {
      "match": "divi/et_pb_post_content",
      "component": "prose",
      "props": {
        "html": "html:"
      }
    },
    {
      "match": "divi/et_pb_video",
      "component": "embed",
      "props": {
        "url": "attr:src",
        "playLabel": "ui:embed.play",
        "showLabel": "ui:embed.show"
      }
    },
    {
      "match": "divi/et_pb_map",
      "component": "embed",
      "variant": {
        "aspect": "map"
      },
      "props": {
        "address": "attr:address",
        "playLabel": "ui:embed.play",
        "showLabel": "ui:embed.show"
      }
    }
  ]
}
