---
// Site header: name/logo and the primary menu. On narrow screens the menu
// folds into a native <details> disclosure — no JavaScript.
import type { CollectionEntry } from 'astro:content'
import { getMenu } from '../lib/content'
import { siteConfig } from '../site.config'
import MenuList from './MenuList.astro'

interface Props {
  site: CollectionEntry<'site'>['data']
  t: (key: string) => string
}

const { site, t } = Astro.props
const menu = await getMenu(siteConfig.menus.primary)
---
<header class="border-b border-line">
  <div class="container-page flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center gap-3 text-lg font-semibold tracking-tight text-ink no-underline">
      {site.logo && <img src={site.logo} alt="" width="32" height="32" class="size-8" />}
      <span>{site.title}</span>
    </a>
    {menu.length > 0 && (
      <nav aria-label={t('nav.label')}>
        <div class="hidden md:block">
          <MenuList links={menu} class="flex items-center gap-6 text-sm" />
        </div>
        <details class="group relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-3 py-2 text-sm font-medium hover:bg-line/40 [&::-webkit-details-marker]:hidden">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            {t('nav.menu')}
          </summary>
          <div class="absolute right-0 z-20 mt-2 w-64 rounded-lg border border-line bg-surface p-4 shadow-lg">
            <MenuList links={menu} class="flex flex-col gap-3 text-sm" />
          </div>
        </details>
      </nav>
    )}
  </div>
</header>
