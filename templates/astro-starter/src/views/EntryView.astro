---
// One entry of a custom post type: title, image, rich-text body, the terms it is filed under and its typed
// fields (siteConfig.types), each labelled as the editor knows it.
import FieldList from '../components/FieldList.astro'
import KitImage from '../components/kit/_shared/KitImage.astro'
import Prose from '../components/kit/prose/Prose.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getEntry } from 'astro:content'
import { getSite, getStrings, imageOf, type Media } from '../lib/content'
import { bodyOf, dateOf, entriesOf, entryHref, entryTitle, newestFirst, refIds, termHref, text, type TypeEntry } from '../lib/custom'
import { shownFields, type Targets } from '../lib/fields'
import { publicHtml } from '../lib/links'
import { summarize } from '../lib/seo'
import type { CustomType } from '../site.config'

interface Props {
  type: CustomType
  entry: TypeEntry
  targets: Targets
}

const { type, entry, targets } = Astro.props
const { data } = entry
const [site, t, fields, body, siblings] = await Promise.all([
  getSite(),
  getStrings(),
  shownFields(type.fields, data, targets),
  bodyOf(type, entry) ? publicHtml(bodyOf(type, entry)) : undefined,
  type.adjacent || type.more ? entriesOf(type.collection) : [],
])
// Newest first: the previous entry is the older one, the next the newer, as in WordPress.
const ordered = newestFirst(siblings, type.card.date)
const at = ordered.findIndex(other => other.id === entry.id)
const previous = at >= 0 ? ordered[at + 1] : undefined
const next = at > 0 ? ordered[at - 1] : undefined
const more = type.more ? ordered.filter(other => other.id !== entry.id).slice(0, type.more) : []
const formatDate = (date: Date) => date.toLocaleDateString(site.language, { dateStyle: 'long', timeZone: 'UTC' })
const [imageId] = type.card.image ? refIds(data[type.card.image]) : []
const cover = imageId ? await getEntry('media', imageId) : undefined
const taxonomy = type.taxonomies?.[0]
const terms = taxonomy ? (await entriesOf(taxonomy.collection)).filter(term => refIds(data[taxonomy.field]).includes(term.id)) : []
const title = entryTitle(type, entry)
const seo = data.seo as { title?: string, description?: string, noindex?: boolean, nofollow?: boolean, canonical?: string } | undefined
const description = seo?.description ?? (type.card.excerpt ? text(data[type.card.excerpt]) : undefined) ?? summarize(body)
---
<BaseLayout
  title={title}
  fullTitle={seo?.title}
  description={description}
  image={cover ? imageOf(cover as Media).src : undefined}
  canonical={seo?.canonical ?? new URL(entryHref(type, entry), Astro.site ?? Astro.url).href}
  noindex={seo?.noindex}
  nofollow={seo?.nofollow}
>
  <article class="container-prose py-12 md:py-16" data-kit-entry>
    {taxonomy && terms.length > 0 && (
      <p class="mb-4 flex flex-wrap gap-3 text-sm font-medium" data-kit-meta>
        {terms.map(term => <a href={termHref(taxonomy, term)} class="text-accent no-underline hover:underline">{text(term.data.name) ?? term.id}</a>)}
      </p>
    )}
    <h1 class="mb-6 text-4xl leading-tight [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance md:text-5xl">{title}</h1>
    {cover && <figure class="mb-10"><KitImage image={imageOf(cover as Media)} priority sizes="(min-width: 768px) 768px, 100vw" class="w-full rounded-[var(--radius-image,0.75rem)]" /></figure>}
    {body && <Prose html={body} />}
    {fields.length > 0 && <div class="mt-10 border-t border-line pt-8"><FieldList fields={fields} locale={site.language} /></div>}
    {(previous || next) && (
      <nav aria-label={t('post.adjacent')} data-cr-part="post-navigation" class="mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-6">
        {previous ? <a href={entryHref(type, previous)} rel="prev" class="text-ink">← {entryTitle(type, previous)}</a> : <span />}
        {next && <a href={entryHref(type, next)} rel="next" class="text-ink">{entryTitle(type, next)} →</a>}
      </nav>
    )}
  </article>
  {more.length > 0 && (
    <section aria-labelledby="more-entries" data-cr-part="related" class="container-page pb-16">
      <h2 id="more-entries" class="mb-4 text-sm font-semibold tracking-wide uppercase">{t('post.more')}</h2>
      <ul class="border-t border-line">
        {more.map((other) => {
          const date = dateOf(other.data[type.card.date ?? 'published_at'])
          return (
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line py-3">
              <a href={entryHref(type, other)} class="text-lg text-ink no-underline hover:underline">{entryTitle(type, other)}</a>
              {date && <time datetime={date.toISOString()} class="text-sm text-ink-muted">{formatDate(date)}</time>}
            </li>
          )
        })}
      </ul>
    </section>
  )}
</BaseLayout>
