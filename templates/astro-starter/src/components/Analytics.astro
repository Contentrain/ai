---
// The site's analytics, from the site settings (Studio: Site → Analytics). No
// script loads until the visitor accepts: the consent banner sets
// `<html data-consent="granted|denied">` and dispatches `kit:consent`
// (`{ granted }`) on `document`. Without the attribute the choice stored on an
// earlier visit answers; without either it is "denied" — a visitor who has not
// been asked is not tracked. It needs the consent bar on the site (the kit's
// Consent section): without one nobody can say yes and nothing ever loads.
// Withdrawn consent stops it on the same page: the loaded script is switched
// off through the provider's own opt-out and its cookies are removed.
import { getSite } from '../lib/content'

const site = await getSite()
const provider = site.analytics_provider
const id = site.analytics_id?.trim()
const host = site.analytics_host?.replace(/\/+$/, '')
// Matomo has no hosted default: without its server there is nothing to load. A
// self-hosted server over plain http would be blocked as mixed content.
const enabled = Boolean(provider && id && (provider !== 'matomo' || host) && (!host || host.startsWith('https://')))
---
{enabled && (
  <script is:inline define:vars={{ provider, id, host }}>
    // define:vars already wraps this script in its own function scope.
    let loaded = false
    // The banner may run after this script (it sits in the body): until it has set the attribute, the choice it
    // stored on an earlier visit answers (`kit-consent`, the Consent component's key).
    const granted = () => {
      const answer = document.documentElement.dataset.consent
      if (answer) return answer === 'granted'
      try { return localStorage.getItem('kit-consent') === 'granted' }
      catch { return false }
    }
    const add = (src, attrs = {}) => {
      const s = document.createElement('script')
      s.async = true
      s.src = src
      for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v)
      document.head.append(s)
    }
    const gtag = function () { (window.dataLayer = window.dataLayer || []).push(arguments) }
    // The provider's own cookies, on this host and on its parent domains (GA sets them on the registrable domain).
    const COOKIES = { ga4: /^(_ga|_gid|_gat)/, gtm: /^(_ga|_gid|_gat|_gcl)/, matomo: /^(_pk_|MATOMO_|mtm_)/ }
    const clearCookies = () => {
      const pattern = COOKIES[provider]
      if (!pattern) return
      const parts = location.hostname.split('.')
      const domains = parts.map((_, i) => parts.slice(i).join('.')).filter(d => d.includes('.'))
      for (const name of document.cookie.split(';').map(c => c.split('=')[0].trim()).filter(n => pattern.test(n))) {
        for (const domain of ['', ...domains]) document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=.${domain}` : ''}`
      }
    }
    const grant = () => {
      if (provider === 'plausible') try { localStorage.removeItem('plausible_ignore') } catch {}
      if (provider === 'fathom' && window.fathom) window.fathom.enableTrackingForMe()
      if (provider === 'ga4') window[`ga-disable-${id}`] = false
      if (loaded) {
        if (provider === 'ga4' || provider === 'gtm') gtag('consent', 'update', { analytics_storage: 'granted' })
        if (provider === 'matomo') window._paq.push(['forgetUserOptOut'])
        return
      }
      loaded = true
      if (provider === 'ga4') {
        gtag('js', new Date())
        gtag('config', id)
        add(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`)
      }
      else if (provider === 'gtm') {
        gtag('consent', 'default', { analytics_storage: 'granted', ad_storage: 'denied' })
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' })
        add(`https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(id)}`)
      }
      else if (provider === 'plausible') add(`${host || 'https://plausible.io'}/js/script.js`, { 'data-domain': id, defer: '' })
      else if (provider === 'fathom') add('https://cdn.usefathom.com/script.js', { 'data-site': id, defer: '' })
      else if (provider === 'matomo') {
        const paq = (window._paq = window._paq || [])
        paq.push(['setTrackerUrl', `${host}/matomo.php`], ['setSiteId', id], ['trackPageView'], ['enableLinkTracking'])
        add(`${host}/matomo.js`)
      }
    }
    // Loaded: no further hits through the provider's own switch. Either way its cookies go — a migrated site often
    // still carries the old WordPress site's `_ga` / `_pk_` on the same domain.
    const revoke = () => {
      clearCookies()
      if (!loaded) return
      if (provider === 'ga4') { window[`ga-disable-${id}`] = true; gtag('consent', 'update', { analytics_storage: 'denied' }) }
      if (provider === 'gtm') gtag('consent', 'update', { analytics_storage: 'denied', ad_storage: 'denied' })
      if (provider === 'plausible') try { localStorage.setItem('plausible_ignore', 'true') } catch {}
      if (provider === 'fathom' && window.fathom) window.fathom.blockTrackingForMe()
      if (provider === 'matomo') window._paq.push(['optUserOut'], ['deleteCookies'])
    }
    // The event's own answer wins (`{ granted }`), so the order in which the banner sets the attribute and
    // dispatches does not matter.
    const apply = (event) => {
      const answer = event?.detail?.granted
      return (typeof answer === 'boolean' ? answer : granted()) ? grant() : revoke()
    }
    apply()
    document.addEventListener('kit:consent', apply)
  </script>
)}
