---
// The block a source's single template prints after the content (siteConfig.post.meta, a custom type's meta): its
// columns of rows, each row the theme's own words and the entry's parts in the source's order — "Yayımlandı 4 Ekim
// 2026 kategorisi Tavuk Bakımı", "yazarı: admin", "Etiketler: kümes". A theme's words print as written; a part prints
// when the entry has it, with its own prefix and suffix, as a WordPress block prints nothing (its label included) for
// an empty one. A row left with nothing to print is not printed.
import type { PostMeta } from '../site.config'

interface Link { label: string, href: string }

interface Props {
  meta: PostMeta
  date?: Date | undefined
  author?: Link | undefined
  terms?: readonly Link[]
  tags?: readonly Link[]
  locale: string
}

const { meta, date, author, terms = [], tags = [], locale } = Astro.props
const formatDate = (value: Date) => value.toLocaleDateString(locale, { dateStyle: 'long', timeZone: 'UTC' })
type Token = PostMeta[number][number][number]
const has = (token: Token): boolean => 'text' in token
  || (token.part === 'date' ? !!date : token.part === 'author' ? !!author : (token.part === 'terms' ? terms : tags).length > 0)
const columns = meta.map(column => column.filter(row => row.some(has))).filter(column => column.length > 0)
---
{columns.length > 0 && (
  <footer data-cr-part="post-meta" class="mt-12 flex flex-col gap-4 border-t border-line pt-6 text-sm md:flex-row md:gap-12">
    {columns.map(column => (
      <div class="flex flex-col gap-2">
        {column.map(row => (
          <p class="flex flex-wrap items-baseline gap-x-1.5">
            {row.filter(has).map(token => 'text' in token ? <span>{token.text}</span> : (
              <span>
                {token.prefix}
                {token.part === 'date' ? <time datetime={date!.toISOString()}>{formatDate(date!)}</time>
                  : token.part === 'author' ? <a href={author!.href} class="text-ink no-underline hover:underline">{author!.label}</a>
                  : (token.part === 'terms' ? terms : tags).map((link, index) => <>{index > 0 && ', '}<a href={link.href} class="text-ink no-underline hover:underline">{link.label}</a></>)}
                {token.suffix}
              </span>
            ))}
          </p>
        ))}
      </div>
    ))}
  </footer>
)}
