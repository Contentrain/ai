---
// Every content address the site builds, from the route table in lib/site-routes.ts.
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { toParam } from '../lib/routes'
import { routeTable } from '../lib/site-routes'
import { composedViews } from '../views/composed'
import ListView from '../views/ListView.astro'
import PageView from '../views/PageView.astro'
import PostView from '../views/PostView.astro'

export const getStaticPaths = (async () => {
  const routes = await routeTable()
  return [...routes].map(([href, route]) => ({ params: { path: toParam(href) }, props: route }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const route = Astro.props as Props
// A page the migration composed from sections has a view of its own.
const PageRoute = route.view === 'page' ? composedViews[route.page.data.wp_id ?? -1] ?? PageView : PageView
---
{route.view === 'post' && <PostView post={route.post} />}
{route.view === 'page' && <PageRoute page={route.page} trail={route.trail} isHome={route.isHome} />}
{route.view === 'list' && <ListView {...route} />}
