---
// A carousel of images with optional captions, of videos (played only when the
// reader asks; a YouTube or Vimeo one only once the reader clicks its poster), or of text cards (a slide with no image: quotes, testimonials). Without JavaScript it is a
// horizontally scrolling, snapping row — every slide is reachable. With it,
// Embla turns the row into a paged carousel with previous/next buttons and
// slide dots. Slider.astro frames it (the section's own look, when a measured
// style is given); the markup and the script are here.
import { tv } from 'tailwind-variants'
import Button from '../_shared/Button.astro'
import KitImage from '../_shared/KitImage.astro'
import SectionHeader from '../_shared/SectionHeader.astro'
import { imageOf, type ImageSource } from '../_shared/image'
import { safeSrc } from '../_shared/safe-url'
import { onVideoHost, videoTarget, type EmbedTarget } from '../_shared/embed-target'
import { measuredSlides } from '../_shared/measured'
import { type ActionInput, type ImageInput, type MeasuredStyle } from '../_shared/types'

const slider = tv({
  slots: {
    // A block viewport around the flex row, as Embla's own markup has it: the row is the container Embla moves.
    viewport: 'snap-x snap-mandatory overflow-x-auto scroll-smooth group-data-[ready]:snap-none group-data-[ready]:overflow-hidden [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
    slide: 'relative min-w-0 shrink-0 snap-start overflow-hidden',
    image: 'w-full object-cover',
    caption: 'flex flex-col items-start gap-2',
    // A slide with no image: its text as a card the height of the row, never laid over an image that is not there.
    card: 'flex h-full flex-col items-start gap-2 rounded-[var(--radius-card)] bg-surface p-6 text-ink ring-1 ring-line/60',
  },
  variants: {
    perView: {
      '1': { slide: 'basis-full' },
      '2': { slide: 'basis-[85%] sm:basis-[calc(50%-0.5rem)]' },
      '3': { slide: 'basis-[85%] sm:basis-[calc(50%-0.5rem)] lg:basis-[calc(33.333%-0.667rem)]' },
    },
    aspect: {
      wide: { image: 'aspect-[4/3] md:aspect-[21/9]' },
      standard: { image: 'aspect-[3/2]' },
      square: { image: 'aspect-square' },
    },
    caption: {
      below: { image: 'rounded-[var(--radius-image,var(--radius-card))]', caption: 'pt-4' },
      // Over the image on wide screens; under it on phones, where the image is too short to hold text.
      overlay: { image: 'rounded-[var(--radius-image,var(--radius-card))] md:rounded-none', slide: 'md:rounded-[var(--radius-image,var(--radius-card))]', caption: 'pt-4 md:absolute md:inset-x-0 md:bottom-0 md:bg-gradient-to-t md:from-ink/80 md:to-transparent md:p-6 md:pt-16 md:text-surface' },
    },
  },
  defaultVariants: { perView: '1', aspect: 'wide', caption: 'overlay' },
})

interface Slide {
  /** The image's address (or, until 0.7, an `ImageInput`). Optional: a text card (a quote, a testimonial) is a slide too. */
  image?: ImageSource | undefined
  imageAlt?: string | undefined
  /**
   * A video file's address (mp4, webm). Drawn in place of the image, which becomes its poster; it loads nothing until
   * the reader plays it, never plays by itself, and pauses when its slide is paged away. The caption sits under it.
   */
  video?: string | undefined
  /**
   * A video on another site: its page (YouTube, Vimeo, Loom, Wistia) or `youtube:<id>` / `vimeo:<id>`. Drawn as its
   * poster (the image, else a dark panel) with a play button; nothing from the provider loads until the reader clicks,
   * and then the player takes the poster's place (YouTube from youtube-nocookie.com, Vimeo with dnt). Paged away, it
   * goes back to its poster. Wins over `video`; an address that is not one of these videos is not drawn.
   */
  embed?: string | undefined
  title?: string | undefined
  text?: string | undefined
  /** The slide's link, flat so a page stays within Contentrain's nesting depth. */
  ctaLabel?: string | undefined
  ctaHref?: string | undefined
  /** Until 0.7: the same link as one object. */
  action?: ActionInput | undefined
}

interface Props {
  slides: Slide[]
  /** The section's head, drawn above the carousel; none of these given, nothing is drawn. */
  heading?: string | undefined
  intro?: string | undefined
  eyebrow?: string | undefined
  actions?: ActionInput[] | undefined
  /** Accessible name of the carousel ("Featured projects"). */
  label: string
  prevLabel?: string | undefined
  nextLabel?: string | undefined
  /** Word before a slide number in dot labels and slide names ("Slide"). */
  slideLabel?: string | undefined
  /** Word between a slide number and the count ("of"). */
  ofLabel?: string | undefined
  /** An embedded video's play button, before its name ("Play"). */
  playLabel?: string | undefined
  loop?: boolean | undefined
  perView?: '1' | '2' | '3' | undefined
  aspect?: 'wide' | 'standard' | 'square' | undefined
  caption?: 'below' | 'overlay' | undefined
  /** The source section's measured style (`MeasuredStyle`): columns per width become the slides in view, gap their spacing. */
  measured?: MeasuredStyle | undefined
  /** Names the track for the buttons' `aria-controls`; unique on the page. */
  id?: string | undefined
  /** Draw the section's own frame and spacing (when Slider.astro has no Section around it). */
  framed?: boolean | undefined
}

const { slides: given, label, prevLabel = 'Previous slide', nextLabel = 'Next slide', slideLabel = 'Slide', ofLabel = 'of', playLabel = 'Play', loop = false, perView = '1', aspect, caption, heading, intro, eyebrow, actions, measured, id = 'slider', framed = true } = Astro.props
// A slide is drawn when it has something to show: an image, a video (a file or another site's), or a text card (a title, a text or a link) where
// the source carousel moved quotes or testimonials. A slide with none of them is dropped.
const slides = given.flatMap((slide) => {
  const player = videoTarget(slide.embed) ?? undefined
  // A video's poster is the site's own image: one on the provider's hosts (its thumbnail) would be a request to it
  // before the reader asked, so the poster is a plain dark panel instead.
  const picture = slide.image === undefined ? undefined : imageOf(slide.image, slide.imageAlt)
  const image = player && onVideoHost(picture?.src) ? undefined : picture
  const video = player ? undefined : safeSrc(slide.video) || undefined
  const action = slide.action ?? (slide.ctaLabel && slide.ctaHref ? { label: slide.ctaLabel, href: slide.ctaHref } : undefined)
  return image || video || player || slide.title || slide.text || action ? [{ ...slide, image, video, player, action }] : []
}) satisfies Array<{ image: ImageInput | undefined, video: string | undefined, player: EmbedTarget | undefined, action?: ActionInput | undefined }>
const measuredRow = measuredSlides(measured)
// A measured row sets the slides in view itself, so the variant's own widths step aside.
const slots = slider({ perView: measuredRow ? '1' : perView, aspect, caption })
// A video's caption is never laid over it: it would cover the player's controls.
const below = slider({ perView: measuredRow ? '1' : perView, aspect, caption: 'below' })
const trackId = `${id}-track`
const sizes = measuredRow ? '(min-width: 1216px) 1152px, 100vw' : perView === '1' ? '(min-width: 1216px) 1152px, 100vw' : perView === '2' ? '(min-width: 640px) 50vw, 85vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 85vw'
// Arrows from sm up; on phones the carousel is swiped and the dots show the position.
const Root = framed ? 'section' : 'div'
const arrow = 'absolute top-1/2 z-10 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-surface/90 text-ink shadow-md ring-1 ring-line hover:bg-surface disabled:opacity-40 sm:group-data-[ready]:flex'
// A text card has no picture for the arrows to sit on: over it they would cover its words. A carousel with any text
// card (all of them, or mixed with pictures) has its arrows under the row, either side of the dots.
const cards = slides.some(slide => !slide.image && !slide.video && !slide.player)
// A video from another site is a link to its page, so without JavaScript it opens there; its frame keeps the image's
// ratio, so the player that replaces the link moves nothing.
const under = 'flex size-11 shrink-0 items-center justify-center rounded-full bg-surface text-ink ring-1 ring-line hover:bg-surface disabled:opacity-40'
---
<Root class:list={['group relative', framed && 'container-page py-8']} role={framed ? undefined : 'region'} aria-roledescription="carousel" aria-label={label} data-kit-slider data-loop={loop ? '' : undefined} data-slide-label={slideLabel}>
  <SectionHeader heading={heading} intro={intro} eyebrow={eyebrow} actions={actions} />
  <div class={slots.viewport()} data-viewport tabindex="0" role="group" aria-label={label}>
    <div class:list={['flex gap-4 [&>*]:shrink-0 group-data-[ready]:[&>*]:snap-align-none', measuredRow?.track]} id={trackId} data-container>
      {slides.map((slide, index) => (
        <div class={slots.slide({ class: measuredRow?.slide })} role="group" aria-roledescription="slide" aria-label={`${slideLabel} ${index + 1} ${ofLabel} ${slides.length}`}>
          {slide.player
            ? (
              <div class={below.image({ class: 'relative overflow-hidden bg-ink' })} data-slide-player>
                <a href={slide.player.href} class="group/play absolute inset-0 block focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-accent" data-embed-src={slide.player.src} data-embed-title={slide.title || slide.image?.alt || `${slideLabel} ${index + 1}`} aria-label={`${playLabel}: ${slide.title || slide.image?.alt || `${slideLabel} ${index + 1}`}`} rel="noopener">
                  {slide.image && <KitImage image={{ ...slide.image, alt: '' }} sizes={sizes} priority={index === 0} class="absolute inset-0 h-full w-full object-cover opacity-85 transition-opacity group-hover/play:opacity-70" />}
                  <span class="absolute top-1/2 left-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-accent text-accent-ink shadow-lg transition-transform group-hover/play:scale-105 group-focus-visible/play:scale-105" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="ms-1 size-7" fill="currentColor"><path d="M7 4.5v15a.5.5 0 0 0 .77.42l11.5-7.5a.5.5 0 0 0 0-.84L7.77 4.08A.5.5 0 0 0 7 4.5Z" /></svg>
                  </span>
                </a>
              </div>
            )
            : slide.video
            ? <video class={below.image({ class: 'bg-ink' })} src={safeSrc(slide.video)} poster={safeSrc(slide.image?.src)} controls preload="none" playsinline aria-label={slide.title ? undefined : slide.image?.alt || `${slideLabel} ${index + 1}`} />
            : slide.image && <KitImage image={slide.image} sizes={sizes} priority={index === 0} class={slots.image()} />}
          {(slide.title || slide.text || slide.action) && (
            <div class={slide.video || slide.player ? below.caption() : slide.image ? slots.caption() : slots.card()}>
              {slide.title && <p class="text-xl [font-weight:var(--font-weight-heading,600)] text-balance">{slide.title}</p>}
              {slide.text && <p class="opacity-85">{slide.text}</p>}
              {slide.action && <Button action={slide.action} size="sm" class="mt-2" />}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
  {slides.length > 1 && (cards
    ? (
      <div class="mt-4 hidden items-center justify-center gap-3 group-data-[ready]:flex">
        <button type="button" class={under} aria-label={prevLabel} aria-controls={trackId} data-prev><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg></button>
        <div class="flex justify-center" data-dots></div>
        <button type="button" class={under} aria-label={nextLabel} aria-controls={trackId} data-next><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    )
    : (
      <>
        <button type="button" class:list={[arrow, 'start-6 md:start-10']} aria-label={prevLabel} aria-controls={trackId} data-prev><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg></button>
        <button type="button" class:list={[arrow, 'end-6 md:end-10']} aria-label={nextLabel} aria-controls={trackId} data-next><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></button>
        <div class="mt-4 hidden justify-center group-data-[ready]:flex" data-dots></div>
      </>
    ))}
</Root>

<script>
  import EmblaCarousel from 'embla-carousel'
  import { playerFrame, plainClick } from '../_shared/embed-frame'

  for (const root of document.querySelectorAll<HTMLElement>('[data-kit-slider]')) {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')
    if (!viewport || root.dataset.ready !== undefined) continue
    root.dataset.ready = ''
    // Reduced motion: slides change instantly instead of gliding.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    // A right-to-left page runs the row from the right: the first slide at the start edge, "next" towards the end.
    const direction = getComputedStyle(root).direction === 'rtl' ? 'rtl' : 'ltr'
    const embla = EmblaCarousel(viewport, { loop: root.dataset.loop !== undefined, align: 'start', containScroll: 'trimSnaps', duration: reduce ? 0 : 25, direction })
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-next]')
    const dots = root.querySelector<HTMLElement>('[data-dots]')
    const track = root.querySelector<HTMLElement>('[data-container]')
    prev?.addEventListener('click', () => embla.scrollPrev())
    next?.addEventListener('click', () => embla.scrollNext())
    // The row takes focus (the buttons are hidden on phones): the arrow keys page it, and a slide change is announced.
    viewport.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
      event.preventDefault()
      if ((event.key === 'ArrowRight') === (direction === 'ltr')) embla.scrollNext()
      else embla.scrollPrev()
    })
    // No autoplay: the carousel only moves when asked, so a polite announcement of the slide is right.
    track?.setAttribute('aria-live', 'polite')

    const label = root.dataset.slideLabel ?? 'Slide'
    // One dot per snap, drawn again whenever Embla measures again: the snaps of a carousel set up before its page was
    // laid out (a background tab, a frame sized later) are not the ones it ends up with.
    let buttons: HTMLButtonElement[] = []
    const drawDots = () => { buttons = embla.scrollSnapList().map((_, index) => {
      const dot = document.createElement('button')
      dot.type = 'button'
      // A 24px target around a 10px dot (WCAG 2.5.8): on phones the dots are the only controls.
      dot.className = 'group/dot grid size-6 place-items-center rounded-full'
      const mark = document.createElement('span')
      mark.className = 'size-2.5 rounded-full bg-ink/25 group-aria-[current=true]/dot:bg-ink'
      dot.append(mark)
      dot.setAttribute('aria-label', `${label} ${index + 1}`)
      dot.addEventListener('click', () => embla.scrollTo(index))
      return dot
    })
    dots?.replaceChildren(...buttons) }
    drawDots()
    const sync = () => {
      const selected = embla.selectedScrollSnap()
      buttons.forEach((dot, index) => dot.setAttribute('aria-current', String(index === selected)))
      if (prev) prev.disabled = !embla.canScrollPrev()
      if (next) next.disabled = !embla.canScrollNext()
    }
    // A video paged out of view stops: nothing plays where the reader cannot see it.
    const pause = () => { for (const video of root.querySelectorAll('video')) if (!video.paused) video.pause() }
    // Another site's video: its poster link becomes the player on a plain click (a swipe that ends on it is not one:
    // Embla cancels that click), and goes back to its poster when its slide is paged out of view, which stops it and
    // ends the provider's session there.
    const posters = new Map<HTMLIFrameElement, HTMLAnchorElement>()
    viewport.addEventListener('click', (event) => {
      if (!plainClick(event)) return
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-slide-player] a[data-embed-src]')
      if (!link?.dataset.embedSrc) return
      event.preventDefault()
      const frame = playerFrame(link.dataset.embedSrc, link.dataset.embedTitle ?? '')
      posters.set(frame, link)
      link.replaceWith(frame)
      frame.focus()
    })
    const unplay = () => {
      const inView = new Set(embla.slidesInView().map(index => embla.slideNodes()[index]))
      for (const [frame, link] of posters) {
        if (inView.has(frame.closest<HTMLElement>('[aria-roledescription="slide"]') ?? undefined)) continue
        frame.replaceWith(link)
        posters.delete(frame)
      }
    }
    embla.on('select', () => { pause(); sync() }).on('settle', unplay).on('reInit', () => { drawDots(); sync() })
    sync()
    // Set up before the layout was final, Embla measures once more when it is: the page loaded, its fonts in, the tab in
    // view. A background tab lays nothing out (ctrl/cmd-click), so its carousel had one snap and a dead "next" until then;
    // Embla's own resize watch does not fire there, since nothing changed size while the tab was hidden. Only a carousel
    // whose row overflows while Embla can page neither way is measured again: one that already pages is left where it is.
    const measure = () => {
      if (track && track.scrollWidth > viewport.clientWidth + 1 && !embla.canScrollNext() && !embla.canScrollPrev()) embla.reInit()
    }
    if (document.readyState !== 'complete') addEventListener('load', measure, { once: true })
    void document.fonts?.ready.then(measure)
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') measure() })
  }
</script>
