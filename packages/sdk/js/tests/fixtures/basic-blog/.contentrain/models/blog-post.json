{
  "id": "blog-post",
  "name": "Blog Post",
  "kind": "collection",
  "domain": "blog",
  "i18n": true,
  "title_field": "title",
  "fields": {
    "author": {
      "model": "author",
      "required": true,
      "type": "relation"
    },
    "category": {
      "options": [
        "tech",
        "design",
        "business"
      ],
      "type": "select"
    },
    "excerpt": {
      "type": "text"
    },
    "featured": {
      "type": "boolean"
    },
    "slug": {
      "required": true,
      "type": "slug",
      "unique": true
    },
    "status": {
      "options": [
        "draft",
        "published",
        "archived"
      ],
      "required": true,
      "type": "select"
    },
    "tags": {
      "model": "tag",
      "type": "relations"
    },
    "title": {
      "required": true,
      "type": "string"
    },
    "views": {
      "type": "integer"
    }
  }
}
