---
// Generated by Contentrain Migrate from the plan route `page-services`: the
// page's sections in order, each bound to the content it shows. Edit the
// content in Contentrain Studio; edit this file to change the page's layout.
import { getEntry } from 'astro:content'
import CardGrid from '../../components/kit/card-grid/CardGrid.astro'
import Faq from '../../components/kit/faq/Faq.astro'
import Slider from '../../components/kit/slider/Slider.astro'
import Tabs from '../../components/kit/tabs/Tabs.astro'
import { getStrings, type Page } from '../../lib/content'
import { publicItems } from '../../lib/links'
import ComposedPage from '../ComposedPage.astro'

interface Props {
  page: Page
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

const { page, trail, isHome } = Astro.props
const t = await getStrings()
const entry0 = await getEntry('sectionCardGrid', 'en/services-0')
const value1 = (await publicItems(entry0?.data.items, ['href'], []))
const section0 = entry0 && value1?.length ? {
  title: entry0.data.title,
  intro: entry0.data.intro,
  items: value1,
  columns: '3' as const,
} : undefined
const entry2 = await getEntry('sectionSlider', 'en/services-1')
const section1 = entry2 && entry2.data.slides?.length && entry2.data.label !== undefined ? {
  label: entry2.data.label,
  slides: entry2.data.slides,
  prevLabel: t('slider.prev'),
  nextLabel: t('slider.next'),
  slideLabel: t('slider.slide'),
  ofLabel: t('slider.of'),
  perView: '1' as const,
  caption: 'below' as const,
} : undefined
const entry3 = await getEntry('sectionTabs', 'en/services-2')
const section2 = entry3 && entry3.data.items?.length ? {
  heading: entry3.data.heading,
  label: t('tabs.label'),
  items: entry3.data.items,
  id: 'visit',
} : undefined
const entry4 = await getEntry('sectionFaq', 'en/services-3')
const section3 = entry4 && entry4.data.items?.length ? {
  heading: entry4.data.heading,
  items: entry4.data.items,
  id: 'questions',
} : undefined
---
<ComposedPage page={page} trail={trail} isHome={isHome} description="Composed: what Northwind does, in sections.">
  {section0 && <CardGrid {...section0} />}
  {section1 && <Slider {...section1} />}
  {section2 && <Tabs {...section2} />}
  {section3 && <Faq {...section3} />}
</ComposedPage>
