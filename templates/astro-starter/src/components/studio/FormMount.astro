---
// The client half of StudioForm: the custom element and the script that
// mounts it. Kept apart so the script ships only on pages that render a form.
// The fields are in the page as HTML (the model's public fields, the markup the
// mount draws), so they show before the script runs and without it; the mount
// then puts Studio's live form (captcha, honeypot) in their place.
import { formFields } from '../../lib/features'
import { fieldsHtml } from '../../lib/studio/form-fields'

interface Props {
  baseUrl: string
  projectId: string
  model: string
  text: Record<string, string>
  class?: string | undefined
}

const { baseUrl, projectId, model, text, class: className } = Astro.props
const fields = formFields(model)
---
<cr-form
  class:list={['cr-form-mount block', className]}
  data-base-url={baseUrl}
  data-project={projectId}
  data-model={model}
  data-strings={JSON.stringify(text)}
>
  {fields.length > 0 && (
    <form class="cr-form" method="post" data-model={model}>
      <Fragment set:html={fieldsHtml(fields)} />
      <noscript><p class="cr-noscript">{text['form.noscript']}</p></noscript>
      <p class="cr-actions"><button type="submit" disabled aria-disabled="true">{text['form.send'] ?? 'Send'}</button></p>
    </form>
  )}
  {fields.length === 0 && <noscript><p class="cr-noscript">{text['form.noscript']}</p></noscript>}
</cr-form>

<script>
  import { mountForm } from '../../lib/studio/embed'

  class CrForm extends HTMLElement {
    connectedCallback() {
      void mountForm(this)
    }
  }
  if (!customElements.get('cr-form')) customElements.define('cr-form', CrForm)
</script>
