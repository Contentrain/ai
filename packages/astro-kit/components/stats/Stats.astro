---
// A row of figures, each with a short label, under an optional heading and
// intro. Figures are static text: no counting animation.
import { tv } from 'tailwind-variants'
import KitImage from '../_shared/KitImage.astro'
import Section, { type Tone } from '../_shared/Section.astro'
import { imageOf, type ImageSource } from '../_shared/image'
import { measuredGrid } from '../_shared/measured'
import type { MeasuredStyle } from '../_shared/types'

const stats = tv({
  slots: {
    list: 'grid grid-cols-2 gap-6 md:gap-8',
    item: 'flex gap-1',
    value: 'text-4xl [font-weight:var(--font-weight-heading,700)] tracking-tight tabular-nums md:text-5xl',
    icon: 'mb-3 block size-10 object-contain',
    label: 'text-sm opacity-80',
  },
  variants: {
    // grid: figures in columns. inline: one line that wraps, for two to four short figures.
    layout: {
      grid: {},
      inline: { list: 'flex flex-wrap gap-x-12 gap-y-6 md:gap-x-16' },
    },
    columns: {
      '2': { list: 'md:grid-cols-2' },
      '3': { list: 'md:grid-cols-3' },
      '4': { list: 'md:grid-cols-4' },
      '5': { list: 'md:grid-cols-3 lg:grid-cols-5' },
      '6': { list: 'md:grid-cols-3 lg:grid-cols-6' },
    },
    style: {
      plain: {},
      card: { item: 'rounded-[var(--radius-card)] bg-surface p-6 text-ink ring-1 ring-line/60' },
      // Hairlines between the figures, none before the first, no box: across on a wide screen, above each on a phone.
      // Meant for a single row (figures no more than the columns); a wrapped row starts with a line.
      divided: { item: 'border-t border-line pt-6 first:border-t-0 first:pt-0 md:border-t-0 md:pt-0 md:border-s md:ps-6 md:first:border-s-0 md:first:ps-0' },
    },
    align: { start: {}, center: { item: 'items-center text-center', icon: 'mx-auto' } },
    // The figure's size: md, lg (the default), xl, or a display number.
    valueSize: {
      md: { value: 'text-3xl md:text-4xl' },
      lg: {},
      xl: { value: 'text-5xl md:text-6xl' },
      display: { value: 'text-6xl md:text-7xl' },
    },
    // accent/accent-ink is only ~5:1 — dimming text on it drops it under 4.5:1 (WCAG 1.4.3).
    tone: { default: {}, muted: {}, inverse: {}, accent: { label: 'opacity-100' } },
    // The label under each figure: small, body size, or large (a counter title set like a subheading).
    labelSize: { sm: {}, base: { label: 'text-base' }, lg: { label: 'text-lg' } },
    // Which comes first in the page's text: the source's own order (a Gutenberg figure is a heading over its label, an
    // Elementor counter names itself first). The figure is drawn on top either way.
    order: { 'label-first': { item: 'flex-col-reverse' }, 'value-first': { item: 'flex-col' } },
  },
  defaultVariants: { layout: 'grid', columns: '3', style: 'plain', align: 'start', valueSize: 'lg', tone: 'default', labelSize: 'sm', order: 'label-first' },
})

interface Item {
  value: string
  label: string
  prefix?: string | undefined
  suffix?: string | undefined
  /** A small picture above the figure (its address); decorative, so it carries no text. */
  icon?: ImageSource | undefined
}

interface Props {
  heading?: string | undefined
  intro?: string | undefined
  items: Item[]
  layout?: 'grid' | 'inline' | undefined
  columns?: '2' | '3' | '4' | '5' | '6' | undefined
  style?: 'plain' | 'card' | 'divided' | undefined
  align?: 'start' | 'center' | undefined
  valueSize?: 'md' | 'lg' | 'xl' | 'display' | undefined
  labelSize?: 'sm' | 'base' | 'lg' | undefined
  order?: 'label-first' | 'value-first' | undefined
  tone?: Tone | undefined
  /** The source section's measured style (`MeasuredStyle`): frame, padding, fill, background image, columns per width, gap. Absent, the site's tokens; present, it wins over tone and columns. */
  measured?: MeasuredStyle | undefined
  id?: string | undefined
}

const { heading, intro, items, layout, columns, style, align, valueSize, labelSize, order, tone, measured, id } = Astro.props
const s = stats({ layout, columns, style, align, valueSize, labelSize, order, tone })
const grid = (layout ?? 'grid') === 'grid' ? measuredGrid(measured) : undefined
const headingId = heading && id ? `${id}-title` : undefined
const iconOf = (item: Item) => imageOf(item.icon, '')
// A <dl> names its term first, so figure-first is a plain list, read in the order it is drawn (WCAG 1.3.2).
---
<Section measured={measured} tone={tone} id={id} aria-labelledby={headingId}>
  {(heading || intro) && (
    <header class="mb-10 flex max-w-2xl flex-col gap-3">
      {heading && <h2 id={headingId} class="text-3xl [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance md:text-4xl">{heading}</h2>}
      {intro && <p class:list={['text-lg', tone === 'accent' ? undefined : 'opacity-80']} data-kit-text>{intro}</p>}
    </header>
  )}
  {order === 'value-first' ? (
    <ul class={s.list({ class: grid })} role="list">
      {items.map(item => (
        <li class={s.item()}>
          <p class={s.value()}>{iconOf(item) && <KitImage image={iconOf(item)!} sizes="40px" class={s.icon()} />}{item.prefix}{item.value}{item.suffix}</p>
          <p class={s.label()}>{item.label}</p>
        </li>
      ))}
    </ul>
  ) : (
    <dl class={s.list({ class: grid })}>
      {items.map(item => (
        <div class={s.item()}>
          <dt class={s.label()}>{item.label}</dt>
          <dd class={s.value()}>{iconOf(item) && <KitImage image={iconOf(item)!} sizes="40px" class={s.icon()} />}{item.prefix}{item.value}{item.suffix}</dd>
        </div>
      ))}
    </dl>
  )}
</Section>
