---
// The page's opening section: heading, lead, actions and an image — beside the
// text, below it, or behind it as a cover with the text over a scrim.
import { tv } from 'tailwind-variants'
import Button from '../_shared/Button.astro'
import KitImage from '../_shared/KitImage.astro'
import Section from '../_shared/Section.astro'
import type { ActionInput, ImageInput } from '../_shared/types'
import { coverHeight as heightOf, headingStyle as styleOf } from './hero'

const hero = tv({
  slots: {
    grid: 'grid items-center gap-10',
    copy: 'flex flex-col gap-5',
    eyebrow: 'text-sm font-semibold tracking-wide uppercase opacity-80',
    heading: 'text-4xl [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance md:text-5xl lg:text-6xl',
    lead: 'max-w-2xl text-lg text-pretty opacity-85 md:text-xl',
    actions: 'flex flex-wrap gap-3 pt-2',
    media: 'overflow-hidden rounded-[var(--radius-image,var(--radius-card))]',
  },
  variants: {
    layout: {
      split: { grid: 'md:grid-cols-2' },
      centered: { copy: 'items-center text-center', lead: 'mx-auto', actions: 'justify-center', media: 'mx-auto w-full max-w-4xl' },
      cover: { grid: 'relative z-10 min-h-[28rem] md:min-h-[36rem]', copy: 'max-w-3xl' },
    },
    // accent/accent-ink is only ~5:1 — dimming text on it drops body copy under 4.5:1 (WCAG 1.4.3), so accent keeps it at full strength.
    tone: { default: {}, muted: {}, inverse: {}, accent: { eyebrow: 'opacity-100', lead: 'opacity-100' } },
    // Where a cover sets its text over the image. WordPress covers centre it unless told otherwise.
    align: { start: {}, center: {} },
    // The lead's own alignment: `start` keeps it at the start edge, across the column, under a centred heading
    // (Hello centres the heading widget and leaves the text editor left in the same container).
    leadAlign: { inherit: {}, start: {} },
    // The buttons' own alignment: `start` keeps them at the start edge under centred text (a WordPress buttons block
    // with no justification sits left inside a cover whose heading and paragraph are centred).
    actionsAlign: { inherit: {}, start: {} },
    // How wide a cover runs: the full window, or the reading column — a WordPress cover block that is not
    // alignfull sits in the content column, the page title above it.
    width: { full: {}, content: {} },
    // The heading's size: the layout's own scale, or the site's size for its level (set inline, see ./hero).
    headingScale: { default: {}, theme: {} },
    // The level whose site size the heading takes when it is not the level it is written at (set inline, see ./hero).
    headingSize: { own: {}, h1: {}, h2: {} },
  },
  compoundVariants: [
    // After the layout's own heights, so a boxed cover keeps WordPress's 430px default.
    { layout: 'cover', width: 'content', class: { grid: 'min-h-[20rem] md:min-h-[26.875rem]' } },
    { layout: 'cover', align: 'center', class: { grid: 'justify-items-center', copy: 'mx-auto items-center text-center', lead: 'mx-auto', actions: 'justify-center' } },
    // After the centring rules, so the lead leaves them.
    { leadAlign: 'start', class: { lead: 'mx-0 max-w-none self-stretch text-start' } },
    { actionsAlign: 'start', class: { actions: 'justify-start self-stretch' } },
  ],
  defaultVariants: { layout: 'split', tone: 'default', align: 'center', leadAlign: 'inherit', actionsAlign: 'inherit', width: 'full', headingScale: 'default', headingSize: 'own' },
})

interface Props {
  heading: string
  /** Heading level: 1 when the hero opens the page (the default), 2 inside a page that already has one. */
  level?: 1 | 2 | undefined
  eyebrow?: string | undefined
  lead?: string | undefined
  actions?: ActionInput[] | undefined
  image?: ImageInput | undefined
  layout?: 'split' | 'centered' | 'cover' | undefined
  /** Text position over a cover image; other layouts ignore it. */
  align?: 'start' | 'center' | undefined
  /** The lead's alignment: as the layout sets it, or at the start edge under a centred heading. */
  leadAlign?: 'inherit' | 'start' | undefined
  /** The buttons' alignment: as the layout sets it, or at the start edge under centred text. */
  actionsAlign?: 'inherit' | 'start' | undefined
  /** A cover's width: the full window (the default) or the reading column; other layouts ignore it. */
  width?: 'full' | 'content' | undefined
  tone?: 'default' | 'muted' | 'inverse' | 'accent' | undefined
  id?: string | undefined
  /** A cover's own height in pixels, as the source sets it (`520`); absent, the layout's default. Layout cover only. */
  minHeight?: number | undefined
  /** `theme`: the heading takes the site's size for its level (the source's own `h1` size), not the layout's scale. */
  headingScale?: 'default' | 'theme' | undefined
  /** The level whose site size the heading takes, when it is not the level it is written at (`h1` size on an `h2`: a page keeps one `h1`). `own` (absent): the heading's own level under `theme`, as before. */
  headingSize?: 'own' | 'h1' | 'h2' | undefined
}


const { heading, level = 1, eyebrow, lead, actions = [], image, layout = 'split', align, leadAlign, actionsAlign, width = 'full', tone, id, minHeight, headingScale, headingSize } = Astro.props
const s = hero({ layout, align, leadAlign, actionsAlign, width, tone, headingScale, headingSize })
const Heading = level === 1 ? 'h1' : 'h2'
const headingId = id ? `${id}-title` : undefined
const cover = layout === 'cover' && image
const coverHeight = cover ? heightOf(minHeight) : undefined
const headingStyle = styleOf(headingScale, level, headingSize)
---
{cover && width === 'content'
  ? (
    <Section tone="none" spacing="sm" width="prose" id={id} aria-labelledby={headingId}>
      <div class="relative isolate overflow-hidden bg-ink text-surface">
        <KitImage image={image} priority sizes="(min-width: 768px) 46rem, 100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-ink/60" aria-hidden="true" />
        <div class="px-6 py-10 md:px-10">
          <div class={s.grid()} style={coverHeight ? `min-height: ${coverHeight}` : undefined}>
            <div class={s.copy()}>
              {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
              <Heading id={headingId} class={s.heading()} style={headingStyle}>{heading}</Heading>
              {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
              {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
            </div>
          </div>
        </div>
      </div>
    </Section>
  )
  : cover
  ? (
    <Section tone="inverse" spacing="none" width="none" id={id} aria-labelledby={headingId} class="relative isolate overflow-hidden">
      <KitImage image={image} priority sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-ink/60" aria-hidden="true" />
      <div class="container-page py-16 md:py-28">
        <div class={s.grid()} style={coverHeight ? `min-height: ${coverHeight}` : undefined}>
          <div class={s.copy()}>
            {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
            <Heading id={headingId} class={s.heading()} style={headingStyle}>{heading}</Heading>
            {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
            {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
          </div>
        </div>
      </div>
    </Section>
  )
  : (
    <Section tone={tone} spacing="lg" id={id} aria-labelledby={headingId}>
      {/* Without an image a split has nothing beside the text: the text takes the whole row, not half of it. */}
      <div class={s.grid({ class: image ? undefined : 'md:grid-cols-1' })}>
        <div class={s.copy()}>
          {eyebrow && <p class={s.eyebrow()}>{eyebrow}</p>}
          <Heading id={headingId} class={s.heading()} style={headingStyle}>{heading}</Heading>
          {lead && <p class={s.lead()} data-kit-text>{lead}</p>}
          {actions.length > 0 && <div class={s.actions()}>{actions.map(action => <Button action={action} size="lg" />)}</div>}
        </div>
        {image && (
          <div class={s.media()}>
            <KitImage image={image} priority sizes={layout === 'split' ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 1024px) 56rem, 100vw'} class="h-auto w-full object-cover" />
          </div>
        )}
      </div>
    </Section>
  )}
