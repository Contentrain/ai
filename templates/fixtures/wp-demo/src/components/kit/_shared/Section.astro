---
// A page section: background tone, vertical rhythm and the page frame. Every
// section component renders inside one, so sections stack evenly whatever
// their order.
import { tv } from 'tailwind-variants'
import { measuredFrame } from './measured'
import { mutedAccent, mutedBrand, mutedInverse, mutedReset } from './muted'
import { safeSrc } from './safe-url'
import type { MeasuredStyle } from './types'

const section = tv({
  base: '',
  variants: {
    tone: {
      default: `bg-surface text-ink ${mutedReset}`,
      muted: `bg-surface-muted text-ink ${mutedReset}`,
      // A dark band reads the accent's text colour made for it (`--color-accent-text-inverse`), and its quieter text
      // the muted role made for it (`muted.ts`).
      inverse: `bg-ink text-surface [--color-accent-text:var(--color-accent-text-inverse)] ${mutedInverse}`,
      accent: `bg-accent text-accent-ink ${mutedAccent}`,
      // The site's brand colour where it is not the accent (a band the source paints in the builder's own colour).
      brand: `bg-brand text-brand-ink ${mutedBrand}`,
      // No fill of its own: the page's background and text colour show through.
      none: '',
    },
    spacing: {
      none: '',
      sm: 'py-8 md:py-12',
      md: 'py-12 md:py-20',
      lg: 'py-16 md:py-28',
    },
  },
  defaultVariants: { tone: 'default', spacing: 'md' },
})

export type Tone = 'default' | 'muted' | 'inverse' | 'accent'

interface Props {
  tone?: Tone | 'brand' | 'none' | undefined
  spacing?: 'none' | 'sm' | 'md' | 'lg' | undefined
  /** `page` is the full frame, `prose` the reading column, `none` for full-bleed content. */
  width?: 'page' | 'prose' | 'none' | undefined
  as?: 'section' | 'div' | 'aside' | undefined
  id?: string | undefined
  class?: string | undefined
  'aria-labelledby'?: string | undefined
  /** The component this section is (`hero`, `card-grid`): `data-kit-section`'s value, the hook a theme or a design layer styles one kind of section by. */
  kit?: string | undefined
  /** The page entry the section is built from, without its locale (`services-0`): `data-kit-entry`'s value, the hook a design layer styles this one section by. Absent, none is printed. */
  entry?: string | undefined
  /** The source section's measured style (`MeasuredStyle`): frame width, padding, fill, image, columns, gap. Wins over `tone`. */
  measured?: MeasuredStyle | undefined
}

const { tone: given, spacing, width = 'page', as: Tag = 'section', id, class: className, 'aria-labelledby': labelledBy, kit, entry, measured } = Astro.props
const m = measuredFrame(measured)
// A measured fill is the section's own colour, its text set by the measured tone; a tone alone picks the kit's band.
const tone = m.color ? 'none' : m.tone === 'dark' ? 'inverse' : m.tone === 'light' ? 'default' : given
const text = m.color ? (m.tone === 'dark' ? `text-surface [--color-accent-text:var(--color-accent-text-inverse)] ${mutedInverse}` : `text-ink ${mutedReset}`) : undefined
const layered = m.image || m.overlay ? 'relative isolate overflow-hidden' : undefined
const style = [m.color && `background-color: ${m.color}`, m.style].filter(Boolean).join('; ') || undefined
// The reading column reads its own width token.
const frameStyle = width === 'prose' ? m.frameStyle?.replace('--container-page:', '--container-prose:') : m.frameStyle
const backdrop = safeSrc(m.image?.src)
const dataTone = m.color ? (m.tone === 'dark' ? 'inverse' : 'default') : tone ?? 'default'
---
<Tag id={id} aria-labelledby={labelledBy} class={section({ tone, spacing, class: [text, layered, className].filter(Boolean).join(' ') || undefined })} style={style} data-tone={dataTone} data-kit-section={kit ?? ''} data-kit-entry={entry} data-kit-spacing={spacing ?? 'md'} data-kit-measured={measured ? '' : undefined}>
  {m.image && backdrop && <img src={backdrop} alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-10 h-full w-full" style={`object-fit: ${m.image.fit}${m.image.position ? `; object-position: ${m.image.position}` : ''}`} />}
  {m.overlay && <div class="absolute inset-0 -z-10" style={`background: ${m.overlay}`} aria-hidden="true" />}
  {width === 'none' ? <slot /> : <div class={width === 'prose' ? 'container-prose' : 'container-page'} style={frameStyle}><slot /></div>}
</Tag>
