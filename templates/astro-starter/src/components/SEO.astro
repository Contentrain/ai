---
// Everything a page says about itself to search engines and link previews:
// title, description, canonical, robots, Open Graph, Twitter, RSS discovery
// and one JSON-LD graph.
import { withBase } from '../lib/base'
import { serializeLd } from '../lib/seo'

interface Props {
  /** The document title as it should appear, site name included. */
  title: string
  description?: string | undefined
  /** og:title / twitter:title (`shareTitle`): the page's own, not the document title. Absent: the document title. */
  shareTitle?: string | undefined
  /** og:description / twitter:description (`shareDescription`). Absent: the meta description. */
  shareDescription?: string | undefined
  /**
   * Absolute canonical URL. Not printed on a `noindex` page (the 404 page, search, an entry the source kept out of
   * search): a page that asks not to be indexed names no preferred address, as Yoast does, and the 404 page's own
   * address (`/404/`) is not one the site serves.
   */
  canonical: string
  /** Absolute image URL for link previews. */
  image?: string | undefined
  type?: 'website' | 'article'
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  siteName: string
  locale?: string | undefined
  /** The page's posts feed (a root path); absent, the site's `/rss.xml`. */
  feed?: string | undefined
  /**
   * The page in every language that has it, this one included (`hreflang`: a language tag; absolute URLs), and the one
   * a visitor of no listed language gets (`xDefault`: the default locale's). Empty for a page not translated.
   */
  alternates?: ReadonlyArray<{ hreflang: string, href: string }>
  xDefault?: string | undefined
  published?: Date | undefined
  modified?: Date | undefined
  jsonLd?: ReadonlyArray<Record<string, unknown>>
}

const {
  title, description, shareTitle = title, shareDescription = description, canonical, image, type = 'website', noindex = false, nofollow = false,
  siteName, locale, feed: feedPath = withBase('/rss.xml'), alternates = [], xDefault, published, modified, jsonLd = [],
} = Astro.props

const robots = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow', 'max-image-preview:large'].join(', ')
const feed = new URL(feedPath, Astro.site ?? canonical).href
// A page asked not to be indexed names no alternates either: there is no address of it to prefer.
const languages = noindex ? [] : alternates
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
{!noindex && <link rel="canonical" href={canonical} />}
{languages.map(alternate => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
{languages.length > 0 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta name="robots" content={robots} />
<link rel="alternate" type="application/rss+xml" title={siteName} href={feed} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={shareTitle} />
{!noindex && <meta property="og:url" content={canonical} />}
{shareDescription && <meta property="og:description" content={shareDescription} />}
{locale && <meta property="og:locale" content={locale.replace('-', '_')} />}
{languages.filter(alternate => alternate.hreflang !== locale).map(alternate => <meta property="og:locale:alternate" content={alternate.hreflang.replace('-', '_')} />)}
{image && <meta property="og:image" content={image} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={shareTitle} />
{shareDescription && <meta name="twitter:description" content={shareDescription} />}
{image && <meta name="twitter:image" content={image} />}

{jsonLd.length > 0 && <script type="application/ld+json" is:inline set:html={serializeLd(jsonLd)} />}
