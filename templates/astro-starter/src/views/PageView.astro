---
// A single page: breadcrumbs for nested pages, title, body and an optional
// Studio form under it.
import { getEntry } from 'astro:content'
import MediaImage from '../components/MediaImage.astro'
import Prose from '../components/Prose.astro'
import StudioForm from '../components/studio/StudioForm.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getStrings, type Page } from '../lib/content'
import { breadcrumbLd, summarize } from '../lib/seo'

interface Props {
  page: Page
  /** The page's ancestors, root first, each with its address. */
  trail: Array<{ title: string, href: string }>
  isHome: boolean
}

const { page, trail, isHome } = Astro.props
const { data } = page
const [cover, t] = await Promise.all([data.cover ? getEntry(data.cover) : undefined, getStrings()])
const origin = Astro.site ?? Astro.url
const crumbs = [...trail, { title: data.title, href: Astro.url.pathname }]
---
<BaseLayout
  title={data.seo?.title ?? (isHome ? undefined : data.title)}
  description={data.seo?.description ?? data.excerpt ?? summarize(data.body)}
  image={data.seo?.image ?? cover?.data.url}
  canonical={data.seo?.canonical}
  noindex={data.seo?.noindex}
  nofollow={data.seo?.nofollow}
  modified={data.modified_at}
  jsonLd={trail.length > 0 ? [breadcrumbLd(crumbs.map(crumb => ({ name: crumb.title, url: new URL(crumb.href, origin).href })))] : []}
>
  <article class="container-prose py-12 md:py-16">
    {trail.length > 0 && (
      <nav aria-label={t('nav.breadcrumb')} class="mb-6 text-sm text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2">
          {trail.map(crumb => (
            <li class="flex items-center gap-2">
              <a href={crumb.href} class="text-ink-muted no-underline hover:text-ink">{crumb.title}</a>
              <span aria-hidden="true">/</span>
            </li>
          ))}
          <li aria-current="page" class="text-ink">{data.title}</li>
        </ol>
      </nav>
    )}
    {!isHome && <h1 class="mb-10 text-4xl leading-tight font-bold tracking-tight text-balance md:text-5xl">{data.title}</h1>}
    {cover && <MediaImage media={cover} priority sizes="(min-width: 768px) 768px, 100vw" class="mb-10 w-full rounded-xl" />}
    {data.body && <Prose html={data.body} />}
    {data.form && <StudioForm model={data.form} class="mt-12" />}
  </article>
</BaseLayout>
