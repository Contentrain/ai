{
  "name": "@contentrain/emitter-astro",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open Astro emitter for Contentrain migrations — renders a ProjectIR into a working Astro project",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Contentrain/ai.git",
    "directory": "packages/emitter-astro"
  },
  "homepage": "https://ai.contentrain.io",
  "bugs": {
    "url": "https://github.com/Contentrain/ai/issues"
  },
  "keywords": [
    "contentrain",
    "astro",
    "emitter",
    "migration",
    "wordpress",
    "static-site"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@contentrain/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.7.0"
  }
}
