---
// A single post: header (terms, title, byline, date), cover, body, tags and
// the comment thread.
import { getEntry } from 'astro:content'
import MediaImage from '../components/MediaImage.astro'
import Prose from '../components/Prose.astro'
import StudioComments from '../components/studio/StudioComments.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { authorHref, byId, getSite, getStrings, postHref, resolve, termHref, type Post } from '../lib/content'
import { articleLd, summarize } from '../lib/seo'

interface Props {
  post: Post
}

const { post } = Astro.props
const { data } = post
const [site, t, author, categories, tags, cover, categoryMap, tagMap] = await Promise.all([
  getSite(),
  getStrings(),
  data.author ? getEntry(data.author) : undefined,
  resolve(data.categories),
  resolve(data.tags),
  data.cover ? getEntry(data.cover) : undefined,
  byId('categories'),
  byId('tags'),
])
const locale = site.language ?? 'en'
const url = new URL(postHref(post), Astro.site ?? Astro.url).href
const description = data.seo?.description ?? data.excerpt ?? summarize(data.body)
const image = data.seo?.image ?? cover?.data.url
const formatDate = (date: Date) => date.toLocaleDateString(locale, { dateStyle: 'long', timeZone: 'UTC' })
const updated = data.modified_at && data.published_at && data.modified_at.getTime() - data.published_at.getTime() > 86_400_000
---
<BaseLayout
  title={data.seo?.title ?? data.title}
  description={description}
  image={image}
  canonical={data.seo?.canonical}
  type="article"
  noindex={data.seo?.noindex}
  nofollow={data.seo?.nofollow}
  published={data.published_at}
  modified={data.modified_at}
  jsonLd={[articleLd({ name: site.title, url: new URL('/', Astro.site ?? Astro.url).href }, {
    url,
    headline: data.title,
    description,
    image: image ? new URL(image, Astro.site ?? Astro.url).href : undefined,
    published: data.published_at,
    modified: data.modified_at,
    author: author ? { name: author.data.name, url: new URL(authorHref(author), Astro.site ?? Astro.url).href } : undefined,
    section: categories[0]?.data.name,
    keywords: tags.map(tag => tag.data.name),
  })]}
>
  <article class="container-prose py-12 md:py-16">
    <header class="mb-10 flex flex-col gap-4">
      {categories.length > 0 && (
        <p class="flex flex-wrap gap-3 text-sm font-medium">
          {categories.map(category => <a href={termHref('category', category, categoryMap)} class="text-accent no-underline hover:underline">{category.data.name}</a>)}
        </p>
      )}
      <h1 class="text-4xl leading-tight font-bold tracking-tight text-balance md:text-5xl">{data.title}</h1>
      <p class="flex flex-wrap items-center gap-x-2 text-ink-muted">
        {author && <span>{t('post.by')} <a href={authorHref(author)} class="font-medium text-ink no-underline hover:text-accent">{author.data.name}</a></span>}
        {author && data.published_at && <span aria-hidden="true">·</span>}
        {data.published_at && <time datetime={data.published_at.toISOString()}>{formatDate(data.published_at)}</time>}
        {updated && data.modified_at && (
          <span class="text-sm">({t('post.updated')} <time datetime={data.modified_at.toISOString()}>{formatDate(data.modified_at)}</time>)</span>
        )}
      </p>
    </header>
    {cover && (
      <figure class="mb-10 -mx-4 md:-mx-8">
        <MediaImage media={cover} priority sizes="(min-width: 768px) 768px, 100vw" class="w-full rounded-none md:rounded-xl" />
        {cover.data.caption && <figcaption class="mt-3 px-4 text-center text-sm text-ink-muted">{cover.data.caption}</figcaption>}
      </figure>
    )}
    {data.body && <Prose html={data.body} />}
    {tags.length > 0 && (
      <footer class="mt-12 flex flex-wrap items-center gap-2 border-t border-line pt-6">
        <span class="text-sm text-ink-muted">{t('post.tags')}:</span>
        {tags.map(tag => <a href={termHref('tag', tag, tagMap)} class="rounded-full border border-line px-3 py-1 text-sm text-ink no-underline hover:border-accent hover:text-accent">{tag.data.name}</a>)}
      </footer>
    )}
    {data.comments_open && <StudioComments model="posts" entry={post.id} />}
  </article>
</BaseLayout>
