---
// One post in a list: image, category, date, title, excerpt and author. The
// whole card is clickable through its title link. `surface: card` makes it a
// card of its own (background, radius, shadow, padded text, image flush);
// `byline: below` prints the category above the title and `author / date`
// under it, as card themes do.
import { tv } from 'tailwind-variants'
import KitImage from '../_shared/KitImage.astro'
import type { ImageInput, LinkInput } from '../_shared/types'

const card = tv({
  slots: {
    root: 'group relative flex gap-4',
    media: 'shrink-0 overflow-hidden rounded-[var(--radius-image,var(--radius-card))]',
    body: 'flex min-w-0 flex-col gap-2',
    meta: 'flex flex-wrap items-center gap-x-2 text-sm text-ink-muted',
    title: 'leading-snug [font-weight:var(--font-weight-heading,600)] text-balance text-ink',
    excerpt: 'text-ink-muted',
  },
  variants: {
    layout: {
      vertical: { root: 'flex-col', media: 'w-full', title: 'text-xl', excerpt: 'line-clamp-3' },
      horizontal: { root: 'flex-col sm:flex-row sm:items-start', media: 'w-full sm:w-64', title: 'text-xl', excerpt: 'line-clamp-2' },
      minimal: { root: 'flex-col border-b border-line pb-5', media: 'hidden', title: 'text-lg', excerpt: 'line-clamp-2' },
    },
    surface: {
      plain: {},
      card: { root: 'gap-0 overflow-hidden rounded-[var(--radius-card)] bg-card shadow-[var(--shadow-card,none)]', media: 'rounded-none', body: 'gap-3 p-[var(--spacing-card,1.5rem)]' },
    },
    byline: {
      inline: {},
      below: { meta: 'text-xs font-semibold text-accent-text' },
    },
  },
  defaultVariants: { layout: 'vertical', surface: 'plain', byline: 'inline' },
})

interface Props {
  title: string
  href: string
  excerpt?: string | undefined
  /** Publication date: a Date, or ISO 8601 text as Contentrain stores it. */
  date?: Date | string | undefined
  /** BCP 47 locale the date is written in (site.language). */
  locale?: string | undefined
  image?: ImageInput | undefined
  category?: LinkInput | undefined
  author?: string | undefined
  headingLevel?: 2 | 3 | undefined
  layout?: 'vertical' | 'horizontal' | 'minimal' | undefined
  surface?: 'plain' | 'card' | undefined
  byline?: 'inline' | 'below' | undefined
  /** Clamp the excerpt to this many lines; absent, the layout's own (3 vertical, 2 otherwise). */
  excerptLines?: 2 | 3 | 4 | undefined
  /** The title in the site's link colour, as themes that colour every link do (Hello Elementor). */
  linkTitle?: boolean | undefined
  /** The image's `sizes` hint; absent, the card's own guess. A list passes the slot its columns give. */
  sizes?: string | undefined
  /** The image block's height as the source sets it (a CSS length or `clamp()`), cropped to fit; wins over `imageAspect`. */
  imageHeight?: string | undefined
  /** The image block's aspect ratio (`16 / 9`) where the source sets an aspect ratio; absent, 16 / 9. */
  imageAspect?: string | undefined
}

const { title, href, excerpt, date: rawDate, locale = 'en', image, category, author, headingLevel = 2, layout, surface, byline, linkTitle, excerptLines, sizes, imageHeight, imageAspect } = Astro.props
const date = rawDate === undefined ? undefined : new Date(rawDate)
const slots = card({ layout, surface, byline })
const below = byline === 'below'
const shown = date?.toLocaleDateString(locale, { dateStyle: 'long', timeZone: 'UTC' })
const imageStyle = imageHeight ? `height:${imageHeight}` : imageAspect ? `aspect-ratio:${imageAspect}` : undefined
const Heading = `h${headingLevel}` as 'h2' | 'h3'
---
<article class={slots.root()}>
  {image && layout !== 'minimal' && (
    <div class={slots.media()}>
      <KitImage image={image} sizes={sizes ?? (layout === 'horizontal' ? '256px' : '(min-width: 1024px) 360px, 100vw')} class:list={['w-full object-cover transition duration-300 group-hover:scale-[1.02]', !imageStyle && 'aspect-[16/9]']} style={imageStyle} />
    </div>
  )}
  <div class={slots.body()}>
    {below && category && (
      <p class={slots.meta()}>
        <a href={category.href} class="relative z-10 no-underline hover:underline">{category.label}</a>
      </p>
    )}
    {!below && (category || date) && (
      <p class={slots.meta()}>
        {category && <a href={category.href} class="relative z-10 font-medium text-accent-text no-underline hover:underline">{category.label}</a>}
        {category && date && <span aria-hidden="true">·</span>}
        {date && <time datetime={date.toISOString()}>{shown}</time>}
      </p>
    )}
    <Heading class={slots.title({ class: linkTitle ? 'text-[color:var(--color-link,var(--color-accent))]' : undefined })}>
      <a href={href} class="text-current no-underline after:absolute after:inset-0 after:content-[''] hover:text-accent-text">{title}</a>
    </Heading>
    {below && (author || date) && (
      <p class={slots.meta()}>
        {author && <span>{author}</span>}
        {author && date && <span aria-hidden="true">/</span>}
        {date && <time datetime={date.toISOString()}>{shown}</time>}
      </p>
    )}
    {excerpt && <p class={slots.excerpt({ class: excerptLines ? { 2: 'line-clamp-2', 3: 'line-clamp-3', 4: 'line-clamp-4' }[excerptLines] : undefined })}>{excerpt}</p>}
    {!below && author && <p class="text-sm text-ink-muted">{author}</p>}
  </div>
</article>
