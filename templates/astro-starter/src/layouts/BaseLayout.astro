---
// The document shell every page renders in: head (SEO, font, the one
// stylesheet, consent-gated analytics), skip link, site header, main, site footer
// and the overlays a migration lists in views/overlays (a popup).
import { Font } from 'astro:assets'
import Analytics from '../components/Analytics.astro'
import Footer from '../components/kit/footer/Footer.astro'
import Header from '../components/kit/header/Header.astro'
import SEO from '../components/SEO.astro'
import { servedPath, withBase } from '../lib/base'
import { siteContact } from '../lib/contact'
import { cssLength, cssSpacing, cssWeight } from '../lib/css-size'
import { textDirection } from '../lib/direction'
import { getSite, getStrings } from '../lib/content'
import { onWordPress } from '../lib/features'
import { menusAt } from '../lib/links'
import { queryMap } from '../lib/redirects'
import { describePage, documentTitle, organizationLd, websiteLd } from '../lib/seo'
import { shareDescription, shareTitle } from '../lib/share'
import { siteConfig } from '../site.config'
import { overlays } from '../views/overlays'
import '../styles/global.css'

interface Props {
  /** The page's own title; siteConfig.titleTemplate adds the site name, unless this is the home page. */
  title?: string | undefined
  /** A complete document title (an SEO override), used as it is. */
  fullTitle?: string | undefined
  description?: string | undefined
  /** The source's own og:title (`seo.og_title`); absent, previews show the page's title without the site suffix. */
  ogTitle?: string | undefined
  /** The source's own og:description (`seo.og_description`); absent, previews show the meta description. */
  ogDescription?: string | undefined
  /** Absolute or site-relative image for link previews. */
  image?: string | undefined
  /** An explicit canonical (an SEO override); the page's own address otherwise. */
  canonical?: string | undefined
  type?: 'website' | 'article'
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  published?: Date | undefined
  modified?: Date | undefined
  jsonLd?: ReadonlyArray<Record<string, unknown>>
}

const { title, fullTitle: seoTitle, description, ogTitle, ogDescription, image, canonical, type, noindex, nofollow, published, modified, jsonLd = [] } = Astro.props
const [site, t, [primary], footerMenus] = await Promise.all([getSite(), getStrings(), menusAt('header'), menusAt('footer')])
const contact = siteContact(site, siteConfig.contact)
const sameAs = (site.same_as ?? []).map(url => ({ label: new URL(url).hostname.replace(/^www\./, ''), href: url }))
const social = [...sameAs, ...contact.socials.filter(link => !sameAs.some(known => known.href === link.href))]
const origin = Astro.site ?? Astro.url
const home = new URL(withBase('/'), origin).href
const identity = { name: site.title, url: home, description: site.tagline, logo: site.logo, sameAs: site.same_as }
const isHome = Astro.url.pathname === withBase('/')
// A latest-posts home is no entry: its SEO title and description are the site's (`site.seo`, written from the source).
const homeSeo = isHome ? site.seo : undefined
const fullTitle = documentTitle({ seoTitle, title, isHome, home: homeSeo, site: site.title, tagline: site.tagline, template: siteConfig.titleTemplate })
const metaDescription = describePage({ own: description ?? homeSeo?.description, label: isHome ? undefined : title, site: site.title, tagline: site.tagline })
const lang = site.language
const shareImage = image ?? site.social_image
// Two or more footer menus are columns, as the source theme's footer showed them; one is a row of links.
const footerColumns = footerMenus.filter(menu => menu.items.length > 0)
// The "RSS feed" link is the source's only where its footer has one (the feed file is served either way).
const rss = siteConfig.footer?.feed === false ? undefined : { label: t('footer.rss'), href: withBase('/rss.xml') }
// Forms the source showed outside the page content with no place here, kept on WordPress (C5): each links to the
// WordPress page that carries it — reachable, never silently gone. A form of a few pages (`on`: the theme builder's form
// on /contact/) is linked at the end of those pages' content, as a form kept on WordPress is; a site-wide one (a footer
// signup) once from the footer.
const wordpressHost = siteConfig.features?.wordpress ? new URL(siteConfig.features.wordpress).host : ''
const keptForms = siteConfig.features?.forms?.home === 'wordpress'
  ? (siteConfig.features.chromeForms ?? []).flatMap((form) => {
      const href = onWordPress(form.path)
      return href ? [{ ...form, href }] : []
    })
  : []
const footerForms = keptForms.filter(form => !form.on?.length).map(form => ({ label: t(form.role === 'newsletter' ? 'footer.subscribe_wordpress' : 'footer.form_wordpress').replace('{site}', wordpressHost), href: form.href }))
const pageForms = keptForms.filter(form => form.on?.some(path => withBase(path) === Astro.url.pathname))
const footerExtras = [...(rss ? [rss] : []), ...footerForms]
// WordPress's query addresses land on the home page of a static host; a host rule (_redirects) answers
// them with a 301 where the host reads one, and this map sends the browser on everywhere else.
const wpQueries = isHome ? await queryMap() : {}
---
<!doctype html>
<html lang={lang} dir={textDirection(lang)}>
  <head>
    <meta charset="utf-8" />
    {Object.keys(wpQueries).length > 0 && (
      <script is:inline define:vars={{ wpQueries }}>
        const query = new URLSearchParams(location.search)
        for (const [param, targets] of Object.entries(wpQueries)) {
          const to = query.has(param) ? targets[query.get(param)] : undefined
          if (to) { location.replace(to); break }
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }, { subset: 'latin-ext' }]} />
    <SEO
      title={fullTitle}
      description={metaDescription}
      shareTitle={shareTitle({ own: ogTitle ?? homeSeo?.og_title, seoTitle, title, isHome, documentTitle: fullTitle })}
      shareDescription={shareDescription({ own: ogDescription ?? homeSeo?.og_description, description: metaDescription })}
      canonical={canonical ?? new URL(Astro.url.pathname, origin).href}
      image={shareImage ? new URL(servedPath(shareImage), origin).href : undefined}
      type={type ?? 'website'}
      noindex={noindex}
      nofollow={nofollow}
      siteName={site.title}
      locale={lang}
      published={published}
      modified={modified}
      jsonLd={isHome ? [websiteLd(identity), organizationLd(identity), ...jsonLd] : jsonLd}
    />
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col bg-page font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-surface">
      {t('nav.skip')}
    </a>
    <Header
      siteName={site.title}
      logo={site.logo ? { src: site.logo, alt: '' } : undefined}
      tagline={siteConfig.chrome?.tagline ? site.tagline : undefined}
      brandSize={siteConfig.chrome?.brand}
      bordered={siteConfig.chrome?.header?.border === false ? false : undefined}
      brandWeight={cssWeight(siteConfig.chrome?.header?.brandWeight)}
      brandTracking={cssSpacing(siteConfig.chrome?.header?.brandTracking)}
      offsetTop={cssLength(siteConfig.chrome?.header?.offsetTop)}
      padTop={cssLength(siteConfig.chrome?.header?.padTop)}
      padBottom={cssLength(siteConfig.chrome?.header?.padBottom)}
      linkNav={siteConfig.chrome?.navLinks}
      menu={siteConfig.chrome?.menu}
      homeHref={withBase('/')}
      items={primary?.items ?? []}
      navLabel={primary?.name ?? t('nav.label')}
      menuLabel={t('nav.menu')}
      closeLabel={t('nav.close')}
    />
    <main id="main" class="flex-1">
      <slot />
      {pageForms.length > 0 && (
        <div class="container-prose flex flex-col gap-6 py-12">
          {pageForms.map((form, index) => (
            <div class="cr-form-mount block" data-cr-part="form" data-state="wordpress">
              <p class="cr-form-note" id={`cr-kept-form-${index}`}>{t('form.wordpress_note').replace('{site}', wordpressHost)}</p>
              <p class="cr-actions"><a href={form.href} class="cr-form-link" aria-describedby={`cr-kept-form-${index}`}>{t('form.wordpress')}</a></p>
            </div>
          ))}
        </div>
      )}
    </main>
    <Footer
      siteName={site.organization ?? site.title}
      tagline={site.tagline}
      copyright={siteConfig.footer?.copyright ?? siteConfig.chrome?.copyright}
      border={siteConfig.footer?.border}
      align={siteConfig.chrome?.footerAlign}
      pack={siteConfig.chrome?.footerColumns ? 'end' : undefined}
      packGap={siteConfig.chrome?.footerColumns ? `${siteConfig.chrome.footerColumns.gap}px` : undefined}
      narrow={siteConfig.chrome?.footerColumns?.narrowGap !== undefined ? 'row' : undefined}
      packGapNarrow={siteConfig.chrome?.footerColumns?.narrowGap !== undefined ? `${siteConfig.chrome.footerColumns.narrowGap}px` : undefined}
      linkSize={siteConfig.chrome?.footerColumns?.size ? `${siteConfig.chrome.footerColumns.size}px` : undefined}
      linkSizeNarrow={siteConfig.chrome?.footerColumns?.narrowSize ? `${siteConfig.chrome.footerColumns.narrowSize}px` : undefined}
      layout={footerColumns.length > 1 ? 'columns' : 'simple'}
      columns={footerColumns.map((menu, index) => ({ label: menu.name, links: index === footerColumns.length - 1 && footerExtras.length ? [...menu.items, ...footerExtras] : menu.items }))}
      links={[...(footerColumns[0]?.items ?? []), ...footerExtras]}
      social={social}
      contact={contact}
      navLabel={footerColumns[0]?.name ?? t('nav.footer')}
    />
    {overlays.map(Overlay => <Overlay />)}
  </body>
</html>
