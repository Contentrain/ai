---
// Links between the pages of a list. Addresses follow WordPress — the list
// itself for page 1, `<base>page/<n>/` after — so a migrated archive keeps
// its page URLs.
import { tv } from 'tailwind-variants'

const pagination = tv({
  slots: {
    root: 'mt-12 flex flex-wrap items-center gap-1',
    item: 'inline-flex min-w-10 items-center justify-center rounded-md px-3 py-2 text-sm no-underline',
    link: 'text-ink hover:bg-surface-muted',
    current: 'bg-ink font-semibold text-surface',
  },
  variants: {
    style: {
      numbered: {},
      simple: { root: 'justify-between' },
    },
    align: { start: {}, center: {}, end: {} },
  },
  compoundVariants: [
    { style: 'numbered', align: 'start', class: { root: 'justify-start' } },
    { style: 'numbered', align: 'center', class: { root: 'justify-center' } },
    { style: 'numbered', align: 'end', class: { root: 'justify-end' } },
  ],
  defaultVariants: { style: 'numbered', align: 'center' },
})

interface Props {
  /** The list's first-page address, e.g. `/category/news/`. */
  base: string
  current: number
  total: number
  /** Accessible name of the navigation ("Pagination"). */
  label?: string | undefined
  prevLabel?: string | undefined
  nextLabel?: string | undefined
  /** Word read before a page number ("Page"). */
  pageLabel?: string | undefined
  style?: 'numbered' | 'simple' | undefined
  align?: 'start' | 'center' | 'end' | undefined
}

const { base, current, total, label = 'Pagination', prevLabel = 'Previous', nextLabel = 'Next', pageLabel = 'Page', style = 'numbered', align } = Astro.props
const slots = pagination({ style, align })
const href = (page: number) => (page <= 1 ? base : `${base}page/${page}/`)
// First, last and two either side of the current page; gaps become an ellipsis.
const shown = [...new Set([1, current - 2, current - 1, current, current + 1, current + 2, total])]
  .filter(page => page >= 1 && page <= total)
  .toSorted((a, b) => a - b)
---
{total > 1 && (
  <nav aria-label={label} class={slots.root()}>
    {current > 1
      ? <a href={href(current - 1)} rel="prev" class:list={[slots.item(), slots.link()]}>← {prevLabel}</a>
      : style === 'simple' && <span />}
    {style === 'numbered' && shown.map((page, index) => (
      <>
        {index > 0 && page - shown[index - 1]! > 1 && <span class:list={[slots.item(), 'text-ink-muted']} aria-hidden="true">…</span>}
        {page === current
          ? <span aria-current="page" class:list={[slots.item(), slots.current()]}><span class="sr-only">{pageLabel} </span>{page}</span>
          : <a href={href(page)} class:list={[slots.item(), slots.link()]}><span class="sr-only">{pageLabel} </span>{page}</a>}
      </>
    ))}
    {style === 'simple' && <span class="text-sm text-ink-muted">{pageLabel} {current} / {total}</span>}
    {current < total && <a href={href(current + 1)} rel="next" class:list={[slots.item(), slots.link()]}>{nextLabel} →</a>}
  </nav>
)}
