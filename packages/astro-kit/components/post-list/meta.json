{
  "id": "post-list",
  "name": "Post list",
  "description": "A list of posts as cards: a grid, stacked rows, a featured first post over a grid, or a compact title-and-date list. The posts come from the site's own collection; the switches decide which parts of a card show.",
  "category": "section",
  "uses": [
    "post-card"
  ],
  "shared": [
    "Section.astro",
    "types.ts"
  ],
  "variants": {
    "layout": {
      "options": [
        "grid",
        "list",
        "featured",
        "compact"
      ],
      "default": "grid",
      "description": "grid: cards in columns. list: stacked horizontal cards. featured: the first post large over a grid. compact: title and date only."
    },
    "columns": {
      "options": [
        "2",
        "3",
        "4"
      ],
      "default": "3",
      "description": "Cards per row on wide screens (grid and featured)."
    }
  },
  "props": {
    "heading": {
      "type": "string",
      "label": "Heading",
      "description": "Section heading above the posts."
    },
    "intro": {
      "type": "text",
      "label": "Intro",
      "description": "A line or two under the heading."
    },
    "posts": {
      "type": "array",
      "label": "Posts",
      "required": true,
      "content": false,
      "description": "The posts to show, newest first: from the posts collection (the query SDK), never copied from a page.",
      "items": {
        "type": "object",
        "fields": {
          "title": {
            "type": "string",
            "required": true
          },
          "href": {
            "type": "url",
            "required": true
          },
          "excerpt": {
            "type": "text"
          },
          "date": {
            "type": "datetime"
          },
          "image": {
            "type": "object",
            "fields": {
              "src": {
                "type": "image",
                "required": true
              },
              "alt": {
                "type": "string",
                "required": true
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            }
          },
          "category": {
            "type": "object",
            "fields": {
              "label": {
                "type": "string",
                "required": true
              },
              "href": {
                "type": "url",
                "required": true
              }
            }
          },
          "author": {
            "type": "string"
          }
        }
      }
    },
    "showImage": {
      "type": "boolean",
      "default": true,
      "content": false,
      "description": "Show each post's cover."
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true,
      "content": false,
      "description": "Show each post's excerpt."
    },
    "showAuthor": {
      "type": "boolean",
      "default": true,
      "content": false,
      "description": "Show each post's author."
    },
    "showCategory": {
      "type": "boolean",
      "default": true,
      "content": false,
      "description": "Show each post's category."
    },
    "excerptLines": {
      "type": "integer",
      "min": 2,
      "max": 4,
      "content": false,
      "description": "Clamp each excerpt to this many lines."
    },
    "locale": {
      "type": "string",
      "content": false,
      "description": "BCP 47 locale the dates are written in (site.language)."
    },
    "surface": {
      "type": "string",
      "content": false,
      "description": "plain or card: whether each post is a card of its own (post-card surface)."
    },
    "moreHref": {
      "type": "url",
      "content": false,
      "description": "Where the full archive lives; with moreLabel a link follows the list."
    },
    "moreLabel": {
      "type": "string",
      "content": false,
      "description": "Text of the archive link."
    },
    "tone": {
      "type": "string",
      "content": false,
      "description": "Section background: default, muted, inverse or accent."
    },
    "id": {
      "type": "string",
      "content": false,
      "description": "Anchor id of the section; the heading gets `<id>-title`."
    }
  },
  "slots": {},
  "js": "none",
  "dependencies": {},
  "sources": {
    "gutenberg": [
      "core/query",
      "core/latest-posts"
    ],
    "elementor": [
      "elementor/posts",
      "elementor/archive-posts"
    ],
    "divi": [
      "divi/et_pb_blog"
    ],
    "classic": [
      "classic/archive-item"
    ]
  },
  "a11y": "A <ul> of cards, each an <article> with one link (the title, stretched over the card) and a <time datetime>. Cards sit one heading level under the section heading, or at h2 when there is none. Images are decorative next to their title; the featured card keeps reading order.",
  "pattern": {
    "summary": "a repeated post card: image + title + excerpt + date, as a grid, rows or a featured first post",
    "signals": [
      "2-4 columns",
      "date text",
      "one link per card",
      "repeated card structure"
    ]
  }
}
