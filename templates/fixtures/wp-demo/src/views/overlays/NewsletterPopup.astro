---
// Generated by Contentrain Migrate from the plan's layout overlay `newsletter-popup`:
// the overlay bound to its singleton. Edit the content in Contentrain Studio.
import { getEntry } from 'astro:content'

const entry = await getEntry('newsletterPopup', 'newsletter-popup')
---
{entry && (
  <aside class="container-prose py-8" data-cr-part="overlay" aria-labelledby="newsletter-popup-title">
    <h2 id="newsletter-popup-title" class="text-xl font-semibold">{entry.data.heading}</h2>
    {entry.data.text && <p class="mt-2 text-ink-muted">{entry.data.text}</p>}
  </aside>
)}
