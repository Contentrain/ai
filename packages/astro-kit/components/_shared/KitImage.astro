---
// An image through astro:assets, optimized and sized so the layout never
// shifts, from either place a site's media lives:
//
//  - the repository, under public/ (`/media/2026/01/cover.jpg`): the file is
//    read at build time and gets a srcset of resized copies;
//  - a media host the site allows (Contentrain Studio's delivery URLs, in
//    astro.config `image.remotePatterns`): fetched at build time when its
//    size is known, and resized the same way.
//
// Without a stored size, the one the migration measured (src/lib/media.ts).
//
// Anything else — a vector, a host the site does not allow, a remote image of
// unknown size — is a plain lazy <img>: nothing is fetched from a host the
// site did not name.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { mediaSize } from '../../../lib/media'
import type { ImageInput } from './types'

interface Props {
  image: ImageInput
  /** Rendered width in the layout, for srcset selection. */
  sizes?: string | undefined
  class?: string | undefined
  /** The page's largest image: load it first. */
  priority?: boolean | undefined
}

// Raster files under public/, loaded only when a page shows one.
const LOCAL = import.meta.glob<ImageMetadata>('/public/**/*.{avif,gif,jpeg,jpg,png,tif,tiff,webp,AVIF,GIF,JPEG,JPG,PNG,TIF,TIFF,WEBP}', { import: 'default' })

const { image: given, sizes = '100vw', class: className, priority = false } = Astro.props
// Content stores an address; the size the migration measured comes from the site's media table.
const measured = given.width && given.height ? undefined : mediaSize(given.src)
const image: ImageInput = measured ? { ...given, ...measured } : given
const loading = priority ? 'eager' : 'lazy'
const fetchpriority = priority ? 'high' : 'auto'
const path = image.src.startsWith('/') && !image.src.startsWith('//') ? image.src.split(/[?#]/)[0]! : undefined
// A malformed escape (`%E0%A4%A`) is no file in public/: the image stays a plain <img> rather than failing the build.
const decoded = (() => { try { return path === undefined ? undefined : decodeURI(path) } catch { return undefined } })()
const load = decoded === undefined ? undefined : LOCAL[`/public${decoded}`]
const local = load ? await load() : undefined
// The stored size (WordPress's chosen size of the file), else the file's own.
const size = image.width && image.height ? { width: image.width, height: image.height } : {}
// Candidate widths for the srcset, up to the image's own: the browser picks one by `sizes`.
const STEPS = [320, 640, 960, 1280, 1600, 1920, 2560]
const widthsUpTo = (max: number) => [...STEPS.filter(step => step < max), max]
---
{local
  ? <Image src={local} alt={image.alt} {...size} widths={widthsUpTo(image.width ?? local.width)} sizes={sizes} class={className} loading={loading} fetchpriority={fetchpriority} />
  : image.width && image.height && path === undefined
    ? <Image src={image.src} alt={image.alt} width={image.width} height={image.height} widths={widthsUpTo(image.width)} sizes={sizes} class={className} loading={loading} fetchpriority={fetchpriority} />
    : <img src={image.src} alt={image.alt} width={image.width} height={image.height} class={className} loading={loading} fetchpriority={fetchpriority} decoding="async" />}
