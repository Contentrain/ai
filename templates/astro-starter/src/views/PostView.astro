---
// A single post laid out as the source's single template: the header parts in
// its order (siteConfig.post.header), body, tags, the previous and next post,
// the comment thread and a list of more posts.
import { getEntry } from 'astro:content'
import KitImage from '../components/kit/_shared/KitImage.astro'
import PostMeta from '../components/PostMeta.astro'
import Prose from '../components/kit/prose/Prose.astro'
import StudioComments from '../components/studio/StudioComments.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { authorHref, byId, getPosts, getSite, getStrings, imageOf, postHref, resolve, termHref, type Post } from '../lib/content'
import { cssSize } from '../lib/css-size'
import { servedPath, withBase } from '../lib/base'
import { publicHtml } from '../lib/links'
import { articleLd, summarize } from '../lib/seo'
import { siteConfig } from '../site.config'
import { safeHref } from '../components/kit/_shared/safe-url'

interface Props {
  post: Post
}

const { post } = Astro.props
const { data } = post
const [site, t, author, categories, tags, cover, categoryMap, tagMap, body, posts] = await Promise.all([
  getSite(),
  getStrings(),
  data.author ? getEntry(data.author) : undefined,
  resolve(data.categories),
  resolve(data.tags),
  data.cover ? getEntry(data.cover) : undefined,
  byId('categories'),
  byId('tags'),
  publicHtml(data.body),
  getPosts(),
])
const layout = siteConfig.post
// Newest first: the previous post is the older one, the next the newer, as in WordPress.
const at = posts.findIndex(other => other.id === post.id)
const previous = layout.adjacent && at >= 0 ? posts[at + 1] : undefined
const next = layout.adjacent && at > 0 ? posts[at - 1] : undefined
const more = posts.filter(other => layout.moreIncludesCurrent || other.id !== post.id).slice(0, layout.more)
const locale = site.language
const url = new URL(postHref(post, categoryMap), Astro.site ?? Astro.url).href
const description = data.seo?.description ?? data.excerpt ?? summarize(data.body)
const image = data.seo?.image ?? cover?.data.url
const formatDate = (date: Date) => date.toLocaleDateString(locale, { dateStyle: 'long', timeZone: 'UTC' })
const updated = data.modified_at && data.published_at && data.modified_at.getTime() - data.published_at.getTime() > 86_400_000
---
<BaseLayout
  title={data.title}
  fullTitle={data.seo?.title}
  ogTitle={data.seo?.og_title}
  ogDescription={data.seo?.og_description}
  description={description}
  image={image}
  canonical={data.seo?.canonical}
  type="article"
  noindex={data.seo?.noindex}
  nofollow={data.seo?.nofollow}
  published={data.published_at}
  modified={data.modified_at}
  jsonLd={[articleLd({ name: site.title, url: new URL(withBase('/'), Astro.site ?? Astro.url).href }, {
    url,
    headline: data.title,
    description,
    image: image ? new URL(servedPath(image), Astro.site ?? Astro.url).href : undefined,
    published: data.published_at,
    modified: data.modified_at,
    author: author ? { name: author.data.name, url: new URL(authorHref(author), Astro.site ?? Astro.url).href } : undefined,
    section: categories[0]?.data.name,
    keywords: tags.map(tag => tag.data.name),
  })]}
>
  <article class="container-prose py-12 md:py-16" data-cr-post>
    {layout.header.map(part => (
      part === 'terms' ? categories.length > 0 && (
        <p class="mb-4 flex flex-wrap gap-3 text-sm font-medium" data-kit-meta>
          {categories.map(category => <a href={safeHref(termHref('category', category, categoryMap))} class="text-accent-text no-underline hover:underline">{category.data.name}</a>)}
        </p>
      )
      : part === 'title' ? <h1 class="[margin-bottom:var(--spacing-title,1rem)] text-4xl leading-tight [font-weight:var(--font-weight-heading,700)] tracking-tight text-balance md:text-5xl">{data.title}</h1>
      : part === 'byline' ? (
        <p class="mb-10 flex flex-wrap items-center gap-x-2 text-ink-muted" data-kit-meta>
          {author && <span>{t('post.by')} <a href={safeHref(authorHref(author))} class="font-medium text-ink no-underline hover:text-accent-text">{author.data.name}</a></span>}
          {author && data.published_at && <span aria-hidden="true">·</span>}
          {data.published_at && <time datetime={data.published_at.toISOString()}>{formatDate(data.published_at)}</time>}
          {updated && data.modified_at && (
            <span class="text-sm">({t('post.updated')} <time datetime={data.modified_at.toISOString()}>{formatDate(data.modified_at)}</time>)</span>
          )}
          {!layout.header.includes('terms') && categories.length > 0 && (
            <span>{t('post.in')} {categories.map((category, index) => <>{index > 0 && ', '}<a href={safeHref(termHref('category', category, categoryMap))} class="text-ink no-underline hover:text-accent-text">{category.data.name}</a></>)}</span>
          )}
        </p>
      )
      : cover && (
        <figure class="mb-10 -mx-4 md:-mx-8">
          <KitImage image={imageOf(cover)} priority sizes="(min-width: 768px) 768px, 100vw" class="w-full rounded-none md:rounded-[var(--radius-image,0.75rem)]" />
          {cover.data.caption && <figcaption class="mt-3 px-4 text-center text-sm text-ink-muted">{cover.data.caption}</figcaption>}
        </figure>
      )
    ))}
    {body && <Prose html={body} />}
    {layout.meta ? (
      <PostMeta
        meta={layout.meta}
        date={data.published_at}
        author={author ? { label: author.data.name, href: authorHref(author) } : undefined}
        terms={categories.map(category => ({ label: category.data.name, href: termHref('category', category, categoryMap) }))}
        tags={tags.map(tag => ({ label: tag.data.name, href: termHref('tag', tag, tagMap) }))}
        locale={locale}
      />
    ) : tags.length > 0 && (
      <footer class="mt-12 flex flex-wrap items-center gap-2 border-t border-line pt-6">
        <span class="text-sm text-ink-muted">{t('post.tags')}:</span>
        {tags.map(tag => <a href={safeHref(termHref('tag', tag, tagMap))} class="rounded-full border border-line px-3 py-1 text-sm text-ink no-underline hover:border-accent hover:text-accent-text">{tag.data.name}</a>)}
      </footer>
    )}
    {(previous || next) && (
      <nav aria-label={t('post.adjacent')} data-cr-part="post-navigation" class="mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-6" style={cssSize(layout.adjacentText)}>
        {previous ? <a href={safeHref(postHref(previous, categoryMap))} rel="prev" class="text-ink"><span aria-hidden="true" class="inline-block rtl:-scale-x-100">←</span> {previous.data.title}</a> : <span />}
        {next && <a href={safeHref(postHref(next, categoryMap))} rel="next" class="text-ink">{next.data.title} <span aria-hidden="true" class="inline-block rtl:-scale-x-100">→</span></a>}
      </nav>
    )}
    <StudioComments model="posts" entry={post.id} open={data.comments_open} />
  </article>
  {more.length > 0 && (
    <section aria-labelledby="more-posts" data-cr-part="related" class="container-page pb-16">
      <h2 id="more-posts" class="mb-4 text-sm font-semibold tracking-wide uppercase">{t('post.more')}</h2>
      <ul class:list={['border-t border-line', siteConfig.lists.tone === 'muted' && 'text-ink-muted']}>
        {more.map(other => (
          <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line py-3">
            <a href={safeHref(postHref(other, categoryMap))} class="text-lg text-ink no-underline hover:underline" style={cssSize(layout.moreText)}>{other.data.title}</a>
            {other.data.published_at && <time datetime={other.data.published_at.toISOString()} class="text-sm text-ink-muted">{formatDate(other.data.published_at)}</time>}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
