{
  "siteConfig": [
    {
      "from": "    post: '/blog/:slug/',",
      "to": "    post: '/:year/:month/:day/:slug/',"
    },
    {
      "from": "    category: '/category/:slug/',",
      "to": "    category: '/category/latest-news/:slug/',"
    },
    {
      "from": "  sourceHosts: [],",
      "to": "  types: [{\n    collection: 'docs',\n    model: 'docs',\n    single: '/docs/:slug/',\n    taxonomies: [{ collection: 'docsCategory', pattern: '/docs-category/:path/', field: 'docs-category', title: 'Docs category' }],\n    card: { title: 'title', date: 'published_at' },\n    body: 'body',\n    fields: [{ name: 'docs-category', label: 'Docs category', type: 'relations', collection: 'docsCategory' }],\n  }],\n  sourceHosts: [],"
    }
  ],
  "absentFromDist": [
    "\"/about-us/\"",
    "\"/best-employer-surveys-product-page/\"",
    "/2016/10/18/evening-post/",
    "/category/latest-news/latest-news/",
    "/category/latest-news/reviews/",
    "\"/docs/wordpress-file-manager/\"",
    "\"/docs/fix-curl-error-35/\"",
    "\"/docs-category/blocks-and-extensions-spectra-blocks/\""
  ],
  "distFiles": {
    "company/about-us/index.html": {
      "contains": [
        "About us under a parent not moved",
