---
// Site footer: brand and tagline, link columns or a single link row, social
// links and the copyright line.
import { tv } from 'tailwind-variants'
import type { LinkInput } from '../_shared/types'
import { footerLinkSizeClasses, footerVars } from './footer'
import { safeHref } from '../_shared/safe-url'

const footer = tv({
  slots: {
    root: 'mt-auto',
    inner: 'container-page py-10 text-sm',
    muted: 'opacity-75',
    link: 'text-current no-underline opacity-75 hover:opacity-100 hover:underline',
  },
  variants: {
    layout: {
      simple: { inner: 'flex flex-col gap-6 md:flex-row md:items-center md:justify-between' },
      columns: { inner: 'grid gap-10 md:grid-cols-[2fr_repeat(var(--footer-columns),1fr)] md:py-16' },
    },
    tone: {
      default: { root: 'bg-surface text-ink' },
      muted: { root: 'bg-surface-muted text-ink' },
      inverse: { root: 'bg-ink text-surface' },
    },
    // The border on the footer's top side: the default tone's own unless `border` says otherwise.
    border: { on: { root: 'border-t border-line' }, off: {} },
    align: { start: {}, center: { inner: 'items-center justify-items-center text-center md:items-center [&_ul]:justify-center' } },
    // The `columns` layout's link columns: spread from the brand column over the footer's width, or packed at the end
    // edge at their own width (a theme whose footer is the brand left and its menus on the right).
    pack: { spread: {}, end: {} },
    // Packed columns below `md`: stacked, or still side by side from the start edge under the brand. The trailing `1fr` track is
    // the room the brand block spans too: a spanning item that crossed only the `auto` tracks would grow them to its own
    // max-content (menus as wide as the brand's longest line); with a flexible track under it, it does not.
    narrow: { stack: {}, row: { inner: 'grid-cols-[repeat(var(--footer-columns),auto)_1fr] justify-start gap-x-[var(--footer-gap-narrow,1.5rem)]' } },
  },
  compoundVariants: [
    { layout: 'simple', align: 'center', class: { inner: 'md:flex-col md:justify-center' } },
    { layout: 'columns', pack: 'end', class: { inner: 'md:grid-cols-[1fr_repeat(var(--footer-columns),auto)] md:gap-x-[var(--footer-gap,2.5rem)] md:[&>div:first-child]:col-span-1' } },
    { layout: 'columns', pack: 'end', narrow: 'row', class: { inner: '[&>div:first-child]:col-span-full' } },
  ],
  defaultVariants: { layout: 'simple', tone: 'default', align: 'start', pack: 'spread', narrow: 'stack', border: 'off' },
})

interface Props {
  siteName: string
  tagline?: string | undefined
  /** Link groups for the `columns` layout. */
  columns?: Array<{ title?: string | undefined, label?: string | undefined, links: LinkInput[] }> | undefined
  /** A single row of links (the footer menu). */
  links?: LinkInput[] | undefined
  social?: LinkInput[] | undefined
  /** Contact details printed in an `<address>` block; each is optional, and the block is left out when none is set. */
  contact?: { address?: string | undefined, phone?: string | undefined, email?: string | undefined } | undefined
  /** The copyright line, e.g. "© 2026 Northwind Studio"; `{year}` is the current year; `false` prints none. Absent: "© year Site". */
  copyright?: string | false | undefined
  /** Label of the cookie settings link after the copyright line ("Cookie settings"); it reopens the consent bar, so a visitor can withdraw consent as easily as they gave it. Only with a consent bar on the page. */
  consentLabel?: string | undefined
  /** Accessible name of the footer navigation ("Footer"). */
  navLabel?: string | undefined
  layout?: 'simple' | 'columns' | undefined
  tone?: 'default' | 'muted' | 'inverse' | undefined
  align?: 'start' | 'center' | undefined
  /** `columns` layout only: `end` packs the link columns at the end edge, right-aligned, instead of spreading them. */
  pack?: 'spread' | 'end' | undefined
  /** Packed columns only: the space between columns, a CSS length (`98px`). */
  packGap?: string | undefined
  /** Packed columns only: below `md`, `stack` (one column) or `row` (still side by side from the start edge, under the brand). */
  narrow?: 'stack' | 'row' | undefined
  /** Packed columns in a `row` only: the space between them below `md`, a CSS length. */
  packGapNarrow?: string | undefined
  /** The links' font size, a CSS length (`17.88px`); absent, the footer's own. */
  linkSize?: string | undefined
  /** The links' font size below `md`, a CSS length; absent, `linkSize` holds at every width. */
  linkSizeNarrow?: string | undefined
  /** A border on the footer's top side: absent, the default tone has one and the others do not. */
  border?: boolean | undefined
}

const { siteName, tagline, columns = [], links = [], social = [], contact, copyright, consentLabel, navLabel = 'Footer', layout = 'simple', tone, align, pack, packGap, narrow, packGapNarrow, linkSize, linkSizeNarrow, border } = Astro.props
const { root, inner, muted, link } = footer({ layout, tone, align, pack: layout === 'columns' ? pack : undefined, narrow: layout === 'columns' && pack === 'end' ? narrow : undefined, border: (border ?? (tone ?? 'default') === 'default') ? 'on' : 'off' })
// Custom properties the packed columns and sized links read; none when none is set.
const vars = footerVars({ layout, columnCount: columns.length, pack, narrow, packGap, packGapNarrow, linkSize, linkSizeNarrow })
const year = String(new Date().getFullYear())
const phoneHref = contact?.phone?.replace(/[^\d+]/g, '')
const hasContact = Boolean(contact?.address || contact?.phone || contact?.email)
const line = copyright === false ? undefined : copyright?.replaceAll('{year}', year) ?? `© ${year} ${siteName}`
// The line and the cookie settings control share one paragraph; neither: no paragraph.
const hasBottom = Boolean(line || consentLabel)
---
<!-- The cookie settings control is a button, not a link: the Consent component's listener reopens its bar on any [data-kit-consent-open]. -->
<footer class={root()}>
  <div class:list={[inner(), ...footerLinkSizeClasses({ linkSize, linkSizeNarrow })]} data-kit-footer style={vars || undefined}>
    <div class="flex flex-col gap-3">
      <p class="text-base font-semibold" data-kit-brand>{siteName}</p>
      {tagline && <p class={muted()} data-kit-tagline>{tagline}</p>}
      {hasContact && (
        <address class={`${muted()} flex flex-col gap-1 not-italic`} data-kit-contact>
          {contact?.address && <span class="whitespace-pre-line">{contact.address}</span>}
          {contact?.phone && (phoneHref ? <a href={`tel:${phoneHref}`} class={link()}>{contact.phone}</a> : <span>{contact.phone}</span>)}
          {contact?.email && <a href={`mailto:${contact.email}`} class={link()}>{contact.email}</a>}
        </address>
      )}
      {layout === 'columns' && hasBottom && <p class:list={[muted(), 'mt-auto pt-6']}>{line}{consentLabel && <>{line && ' · '}<button type="button" data-kit-consent-open class={link()}>{consentLabel}</button></>}</p>}
    </div>
    {layout === 'columns'
      ? columns.map(column => (
        <nav aria-label={column.label ?? column.title} data-cr-part="nav-footer">
          {column.title && <p class="mb-3 font-semibold">{column.title}</p>}
          <ul class="flex flex-col gap-2">
            {column.links.map(item => <li><a href={safeHref(item.href)} class={link()}>{item.label}</a></li>)}
          </ul>
        </nav>
      ))
      : (
        <div class:list={['flex flex-col gap-4', align === 'center' ? 'items-center' : 'md:items-end']}>
          {social.length > 0 && (
            <ul class="flex flex-wrap gap-4">
              {social.map(item => <li><a href={safeHref(item.href)} rel="me noopener" target="_blank" class={link()}>{item.label}</a></li>)}
            </ul>
          )}
          {links.length > 0 && (
            <nav aria-label={navLabel} data-cr-part="nav-footer">
              <ul class="flex flex-wrap gap-x-6 gap-y-2">
                {links.map(item => <li><a href={safeHref(item.href)} class={link()}>{item.label}</a></li>)}
              </ul>
            </nav>
          )}
          {hasBottom && <p class={muted()}>{line}{consentLabel && <>{line && ' · '}<button type="button" data-kit-consent-open class={link()}>{consentLabel}</button></>}</p>}
        </div>
      )}
    {layout === 'columns' && social.length > 0 && (
      <ul class="flex flex-wrap gap-4 md:col-span-full">
        {social.map(item => <li><a href={safeHref(item.href)} rel="me noopener" target="_blank" class={link()}>{item.label}</a></li>)}
      </ul>
    )}
  </div>
</footer>
