---
// Previous / numbered / next links for a paginated list. Addresses follow
// WordPress (`<list>/page/2/`), so a migrated archive keeps its page URLs.
import { pagePath } from '../lib/routes'

interface Props {
  /** The list's first-page address. */
  base: string
  current: number
  total: number
  t: (key: string) => string
}

const { base, current, total, t } = Astro.props
// First, last, and two either side of the current page; gaps become an ellipsis.
const shown = [...new Set([1, current - 2, current - 1, current, current + 1, current + 2, total])]
  .filter(page => page >= 1 && page <= total)
  .toSorted((a, b) => a - b)
const item = 'inline-flex min-w-10 items-center justify-center rounded-md px-3 py-2 text-sm no-underline'
---
{total > 1 && (
  <nav aria-label={t('pagination.label')} class="mt-12 flex flex-wrap items-center justify-center gap-1">
    {current > 1 && <a href={pagePath(base, current - 1)} rel="prev" class={`${item} text-ink hover:bg-line/40`}>← {t('pagination.prev')}</a>}
    {shown.map((page, index) => (
      <>
        {index > 0 && page - shown[index - 1]! > 1 && <span class={`${item} text-ink-muted`} aria-hidden="true">…</span>}
        {page === current
          ? <span aria-current="page" class={`${item} bg-ink font-semibold text-surface`}><span class="sr-only">{t('pagination.page')} </span>{page}</span>
          : <a href={pagePath(base, page)} class={`${item} text-ink hover:bg-line/40`}><span class="sr-only">{t('pagination.page')} </span>{page}</a>}
      </>
    ))}
    {current < total && <a href={pagePath(base, current + 1)} rel="next" class={`${item} text-ink hover:bg-line/40`}>{t('pagination.next')} →</a>}
  </nav>
)}
