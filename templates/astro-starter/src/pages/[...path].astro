---
// Every content address the site builds, from the route table in lib/site-routes.ts,
// and every old address in the redirects collection as an instant redirect page
// (the host's own 301 rules are in _redirects).
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { redirectRules, type RedirectStatus } from '../lib/redirects'
import { onlyRoutes, toParam } from '../lib/routes'
import { type Route, routeTable } from '../lib/site-routes'
import { composedViews } from '../views/composed'
import { withBase } from '../lib/base'
import { getPosts } from '../lib/content'
import { leftEmpty } from '../lib/empty-page'
import { siteConfig } from '../site.config'
import EntryView from '../views/EntryView.astro'
import ListView from '../views/ListView.astro'
import PageView from '../views/PageView.astro'
import PostView from '../views/PostView.astro'

type Moved = { view: 'redirect', to: string, status: RedirectStatus }

export const getStaticPaths = (async () => {
  const [table, redirects] = await Promise.all([routeTable(), redirectRules()])
  // CONTENTRAIN_ROUTES builds the listed pages alone (a preview of the home page); an address it names that the
  // site does not have is a typo, and stops the build rather than preview nothing.
  const only = onlyRoutes()
  const routes = only ? [...table].filter(([href]) => only.has(toParam(href) ?? '')) : [...table]
  const missing = only ? [...only].filter(param => !routes.some(([href]) => (toParam(href) ?? '') === param)) : []
  if (missing.length) throw new Error(`CONTENTRAIN_ROUTES names ${missing.map(param => `/${param}${param ? '/' : ''}`).join(', ')}, which the site does not build.`)
  // A file address (`/old.pdf`) cannot be a page; the host rules redirect it.
  const moved = redirects.flatMap(rule => (rule.status !== 410 && rule.from.endsWith('/') ? [[rule.from, { view: 'redirect', to: rule.to, status: rule.status }] as const] : []))
  return [...routes, ...moved].map(([href, route]: readonly [string, Route | Moved]) => ({ params: { path: toParam(href) }, props: route }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const route = Astro.props as Props
if (route.view === 'redirect') return Astro.redirect(route.to, route.status)
// A page the migration composed from sections has a view of its own.
const composed = route.view === 'page' ? composedViews[route.page.data.wp_id ?? -1] : undefined
// A page with nothing to build (lib/empty-page.ts) never fails the whole build: one page must not take the site down.
// The front page is never left out (no root is not a working site): it builds as the plain latest-posts home WordPress
// itself shows, the site's title and tagline over its newest posts. Any other page leaves for its nearest parent, else
// the home, so its address keeps working: in this static output `Astro.redirect` writes a meta refresh, and the 301
// itself comes from the host's redirects file (`_redirects`, where the migration lists each page it withheld and says so
// on its receipt). This is the guard behind it.
const empty = leftEmpty(route)
if (empty && route.view === 'page' && !route.isHome) return Astro.redirect(route.trail.at(-1)?.href ?? withBase('/'), 301)
const latest = empty ? (await getPosts()).slice(0, siteConfig.postsPerPage) : []
const PageRoute = composed ?? PageView
---
{route.view === 'post' && <PostView post={route.post} />}
{route.view === 'page' && !empty && <PageRoute page={route.page} trail={route.trail} isHome={route.isHome} subpages={route.subpages} />}
{route.view === 'page' && empty && <ListView seo={route.page.data.seo} description={route.page.data.seo?.description} posts={latest} base={withBase('/')} current={1} total={1} />}
{route.view === 'entry' && <EntryView type={route.type} entry={route.entry} targets={route.targets} />}
{route.view === 'list' && <ListView {...route} />}
