      "field": {
        "type": "true_false"
      },
      "value": 1,
      "expect": {
        "def": {
          "type": "boolean"
        },
        "value": true
      }
    },
    {
      "name": "true_false off",
      "field": {
        "type": "true_false"
      },
      "value": 0,
      "expect": {
        "def": {
          "type": "boolean"
        },
        "value": false
