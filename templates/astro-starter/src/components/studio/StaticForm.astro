---
// A form that posts to the owner's form service (Formspree, Basin, Getform…)
// instead of Studio: plain HTML, no script. The fields are the Studio model's
// public fields (.contentrain/models/<model>.json), the same ones StudioForm
// shows, so switching to Studio later changes the transport, not the form.
// The service shows its own confirmation page. StudioForm renders it only
// when formHome() says it can (https action, at least one field).
import { formFields } from '../../lib/features'
import { fieldsHtml } from '../../lib/studio/form-fields'

interface Props {
  /** The model whose fields the form shows. */
  model: string
  /** The form service's https endpoint. */
  action: string
  text: Record<string, string>
  class?: string | undefined
}

const { model, action, text, class: className } = Astro.props

const fields = formFields(model)
const valid = action.startsWith('https://') && fields.length > 0
const html = fieldsHtml(fields, 'cr-static')
---
{valid && (
  <div class:list={['cr-form-mount block', className]} data-cr-part="form" data-state="endpoint">
    <form class="cr-form" method="post" action={action}>
      <Fragment set:html={html} />
      <p class="cr-hp" aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
        <label>{text['form.honeypot'] ?? 'Leave this field empty'} <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>
      <p class="cr-actions"><button type="submit">{text['form.send'] ?? 'Send'}</button></p>
    </form>
  </div>
)}
